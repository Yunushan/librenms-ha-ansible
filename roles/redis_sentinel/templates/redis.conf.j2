{% set redis_node_address = ansible_default_ipv4.address | default(ansible_host | default(inventory_hostname)) %}
bind {{ '127.0.0.1 ' ~ redis_node_address if librenms_redis_mode == 'sentinel' else '127.0.0.1' }}
protected-mode yes
port 6379
{% if ansible_service_mgr == 'systemd' %}
daemonize no
supervised systemd
{% endif %}
{% if ansible_service_mgr == 'systemd' or ansible_os_family == 'Debian' %}
pidfile {{ librenms_redis_runtime_dir }}/{{ 'valkey-server.pid' if ansible_os_family == 'RedHat' and (ansible_distribution_major_version | int) >= 10 else 'redis-server.pid' }}
logfile ""
{% endif %}
dir {{ librenms_redis_data_dir }}
dbfilename dump.rdb
{% if librenms_redis_persistence_enabled | bool and librenms_redis_save_rules | length > 0 %}
{% for save_rule in librenms_redis_save_rules %}
save {{ save_rule }}
{% endfor %}
{% else %}
save ""
{% endif %}
appendonly {{ ((librenms_redis_persistence_enabled | bool) and (librenms_redis_appendonly | bool)) | ternary('yes', 'no') }}
requirepass {{ librenms_redis_password | to_json }}
masterauth {{ librenms_redis_password | to_json }}
{% if librenms_redis_mode == 'sentinel' and inventory_hostname != librenms_redis_master_host %}
replicaof {{ hostvars[librenms_redis_master_host].ansible_host | default(librenms_redis_master_host) }} 6379
{% endif %}
