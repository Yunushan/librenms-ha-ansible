[Socket]
# The distribution socket unit takes precedence over rrdcached -l options.
# Keep the local control socket and expose the node-local TCP backend expected
# by HAProxy in VIP mode.
ListenStream=
ListenStream={{ librenms_rrdcached_socket }}
{% if librenms_rrdcached_network_enabled | bool %}
ListenStream={{ librenms_rrdcached_network_bind_address_effective }}:{{ librenms_rrdcached_bind_port }}
{% endif %}
SocketMode={{ librenms_rrdcached_socket_mode }}
SocketUser={{ librenms_user }}
SocketGroup={{ librenms_group }}
