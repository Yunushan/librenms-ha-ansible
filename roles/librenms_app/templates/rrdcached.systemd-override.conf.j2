[Unit]
Wants=network-online.target remote-fs.target
After=network-online.target remote-fs.target{% if librenms_rrd_mode == 'glusterfs' %} glusterd.service{% endif %}
RequiresMountsFor={{ librenms_rrdcached_base_path }}
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
Type=simple
User=root
Group=root
PIDFile=
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=30s
{% if librenms_startup_repair_fix_writable_ownership | bool %}
ExecStartPre={{ librenms_rrd_permission_repair_path }}
{% endif %}
ExecStart=
ExecStart={{ librenms_rrdcached_daemon_path }} \
  -g \
  -w {{ librenms_rrdcached_write_timeout }} \
  -z {{ librenms_rrdcached_write_jitter }} \
  -t {{ librenms_rrdcached_write_threads }} \
  -b {{ librenms_rrdcached_base_path }} \
  -j {{ librenms_rrdcached_journal_path }} \
  -p {{ librenms_rrdcached_pidfile }} \
  -B \
  -F \
  -R \
  -s {{ librenms_group }} \
  -m {{ librenms_rrdcached_socket_mode }} \
  -l unix:{{ librenms_rrdcached_socket }}{% if librenms_rrdcached_network_enabled | bool %} \
  -L \
  -l {{ librenms_rrdcached_network_bind_address_effective }}:{{ librenms_rrdcached_bind_port }}{% endif %} \
  -U {{ librenms_user }} \
  -G {{ librenms_group }}
ExecStop=
Restart=on-failure
RestartSec=5s
