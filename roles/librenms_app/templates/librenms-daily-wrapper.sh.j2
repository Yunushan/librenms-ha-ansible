#!/usr/bin/env bash
{% set pre_upgrade_backup_enabled = librenms_manage_scheduled_backups | bool and librenms_backup_pre_upgrade_enabled | bool %}
{% set clear_healthy_update_failure_notification = librenms_daily_self_heal_clear_healthy_update_failure_notification | bool %}
set -u
set -o pipefail

LIBRENMS_DIR="{{ librenms_install_dir }}"
LIBRENMS_USER="{{ librenms_user }}"
WRAPPER_LOCK_PATH="{{ librenms_daily_self_heal_lock_path }}"
PHP_FPM_SERVICE="{{ librenms_php_fpm_service_effective | default(librenms_php_fpm_service_name | default('')) }}"
COMPOSER_INSTALL_TIMEOUT="{{ librenms_composer_install_timeout | int }}"
COMPOSER_PROCESS_TIMEOUT="{{ librenms_composer_process_timeout | int }}"
RESTART_PHP_FPM="{{ librenms_daily_self_heal_restart_php_fpm | bool | ternary('true', 'false') }}"
GIT_LOCK_CLEANUP="{{ librenms_daily_self_heal_git_lock_cleanup | bool | ternary('true', 'false') }}"
GIT_METADATA_REPAIR="{{ librenms_daily_self_heal_git_metadata_repair | bool | ternary('true', 'false') }}"
GIT_RETRY_AFTER_REPAIR="{{ librenms_daily_self_heal_git_retry_after_repair | bool | ternary('true', 'false') }}"
CLEAR_CACHE_AFTER_DAILY="{{ librenms_daily_self_heal_clear_laravel_cache_after_daily | bool | ternary('true', 'false') }}"
HEALTHY_UPDATE_FAILURE_IS_SUCCESS="{{ librenms_daily_self_heal_treat_healthy_update_failure_as_success | bool | ternary('true', 'false') }}"
CLEAR_HEALTHY_UPDATE_FAILURE_NOTIFICATION="{{ clear_healthy_update_failure_notification | ternary('true', 'false') }}"
HEALTHY_FAILURE_NOTIFICATION_CLEANUP_DAYS="{{ librenms_daily_self_heal_notification_cleanup_days | int }}"
GLOBAL_LOCK_ENABLED="{{ librenms_daily_global_lock_enabled | bool | ternary('true', 'false') }}"
GLOBAL_LOCK_HELPER="{{ librenms_daily_global_lock_path }}"
GLOBAL_LOCK_NAME="{{ librenms_daily_global_lock_name }}"
GLOBAL_LOCK_TIMEOUT="{{ librenms_daily_global_lock_timeout | int }}"
GLOBAL_LOCK_BACKEND="{{ librenms_daily_global_lock_backend }}"
GLOBAL_LOCK_SHARED_FILE="{{ librenms_daily_global_lock_shared_file }}"
BACKUP_WRAPPER="{{ librenms_backup_wrapper_path }}"
PRE_UPGRADE_BACKUP_ENABLED="{{ pre_upgrade_backup_enabled | ternary('true', 'false') }}"
PRE_UPGRADE_BACKUP_REQUIRED="{{ librenms_backup_pre_upgrade_required | bool | ternary('true', 'false') }}"
HA_DRAIN_ENABLED="{{ librenms_daily_ha_drain_enabled | bool | ternary('true', 'false') }}"
HA_DRAIN_PATH="{{ librenms_daily_ha_drain_path }}"
HA_DRAIN_DELAY="{{ librenms_daily_ha_drain_delay | int }}"
DAILY_OUTPUT_LOG=""
DRAIN_MARKER_CREATED=false

export HOME="${LIBRENMS_DIR}"
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

log() {
    echo "librenms-daily-wrapper: $*"
}

run_as_librenms() {
    runuser -u "${LIBRENMS_USER}" -- "$@"
}

acquire_cluster_maintenance_lock() {
    local lock_rc

    [ "${GLOBAL_LOCK_ENABLED}" = "true" ] || return 0

    case "${GLOBAL_LOCK_BACKEND}" in
        shared_file)
            if ! command -v flock >/dev/null 2>&1; then
                log "shared maintenance lock requires flock"
                return 1
            fi

            if [ -z "${GLOBAL_LOCK_SHARED_FILE}" ] || [ ! -d "$(dirname "${GLOBAL_LOCK_SHARED_FILE}")" ]; then
                log "shared maintenance lock directory is unavailable"
                return 1
            fi

            exec 9>"${GLOBAL_LOCK_SHARED_FILE}"
            flock -w "${GLOBAL_LOCK_TIMEOUT}" -E 75 9
            lock_rc=$?
            if [ "${lock_rc}" -eq 75 ]; then
                log "another node is maintaining LibreNMS; skipping this trigger"
                return 2
            fi
            if [ "${lock_rc}" -ne 0 ]; then
                log "failed to acquire shared maintenance lock"
                return "${lock_rc}"
            fi

            log "acquired shared maintenance lock"
            ;;
        database)
            log "using database-only maintenance lock"
            ;;
        *)
            log "unsupported maintenance lock backend: ${GLOBAL_LOCK_BACKEND}"
            return 1
            ;;
    esac
}

activate_ha_drain() {
    [ "${HA_DRAIN_ENABLED}" = "true" ] || return 0

    if [ -z "${HA_DRAIN_PATH}" ] || [ ! -d "$(dirname "${HA_DRAIN_PATH}")" ]; then
        log "HA drain marker directory is unavailable"
        return 1
    fi

    if ! printf 'daily maintenance\n' > "${HA_DRAIN_PATH}"; then
        log "failed to create HA drain marker"
        return 1
    fi

    chmod 0644 "${HA_DRAIN_PATH}" || return 1
    DRAIN_MARKER_CREATED=true
    log "draining this web node before maintenance"
    sleep "${HA_DRAIN_DELAY}"
}

cleanup_temp() {
    if [ -n "${DAILY_OUTPUT_LOG}" ] && [ -f "${DAILY_OUTPUT_LOG}" ]; then
        rm -f "${DAILY_OUTPUT_LOG}"
    fi
}

cleanup_ha_drain() {
    if [ "${DRAIN_MARKER_CREATED}" = "true" ] && [ -e "${HA_DRAIN_PATH}" ]; then
        if rm -f -- "${HA_DRAIN_PATH}"; then
            log "rejoined this web node after maintenance"
        else
            log "failed to remove HA drain marker"
        fi
    fi
}

cleanup_on_exit() {
    local status=$?

    cleanup_temp
    cleanup_ha_drain
    return "${status}"
}

git_process_active() {
    command -v pgrep >/dev/null 2>&1 || return 1
    pgrep -u "${LIBRENMS_USER}" -af \
        'git|daily\.sh|composer|composer_wrapper\.php' >/dev/null 2>&1
}

has_git_lock_files() {
    [ -d "${LIBRENMS_DIR}/.git" ] || return 1
    find "${LIBRENMS_DIR}/.git" -name '*.lock' -type f -print -quit |
        grep -q .
}

cleanup_stale_git_locks() {
    [ "${GIT_LOCK_CLEANUP}" = "true" ] || return 0
    [ -d "${LIBRENMS_DIR}/.git" ] || return 0
    has_git_lock_files || return 0

    if git_process_active; then
        log "git lock files exist but a LibreNMS git/composer/daily process is active; keeping locks"
        return 1
    fi

    log "removing stale LibreNMS git lock files"
    if find "${LIBRENMS_DIR}/.git" -name '*.lock' -type f -print -delete; then
        return 0
    fi

    log "failed to remove stale LibreNMS git lock files"
    return 2
}

repair_git_metadata() {
    [ "${GIT_METADATA_REPAIR}" = "true" ] || return 0
    [ -d "${LIBRENMS_DIR}/.git" ] || return 0

    cleanup_stale_git_locks || return 1

    log "refreshing LibreNMS git metadata"
    run_as_librenms git -C "${LIBRENMS_DIR}" remote prune origin || true
    cleanup_stale_git_locks || return 1
    run_as_librenms git -C "${LIBRENMS_DIR}" fetch --prune --tags origin
}

run_daily() {
    cd "${LIBRENMS_DIR}" || return 1
    : > "${DAILY_OUTPUT_LOG}"

    if [ "${GLOBAL_LOCK_ENABLED}" = "true" ]; then
        if [ ! -r "${GLOBAL_LOCK_HELPER}" ]; then
            log "daily maintenance cluster lock helper is unavailable at ${GLOBAL_LOCK_HELPER}"
            return 1
        fi

        env \
            LIBRENMS_DAILY_GLOBAL_LOCK_NAME="${GLOBAL_LOCK_NAME}" \
            LIBRENMS_DAILY_GLOBAL_LOCK_TIMEOUT="${GLOBAL_LOCK_TIMEOUT}" \
            LIBRENMS_DAILY_PRE_UPGRADE_BACKUP_ENABLED="${PRE_UPGRADE_BACKUP_ENABLED}" \
            LIBRENMS_DAILY_PRE_UPGRADE_BACKUP_REQUIRED="${PRE_UPGRADE_BACKUP_REQUIRED}" \
            LIBRENMS_DAILY_BACKUP_WRAPPER="${BACKUP_WRAPPER}" \
            LIBRENMS_DAILY_HA_DRAIN_ENABLED="${HA_DRAIN_ENABLED}" \
            LIBRENMS_DAILY_HA_DRAIN_PATH="${HA_DRAIN_PATH}" \
            LIBRENMS_DAILY_HA_DRAIN_DELAY="${HA_DRAIN_DELAY}" \
            php "${GLOBAL_LOCK_HELPER}" \
            runuser -u "${LIBRENMS_USER}" -- /bin/bash "${LIBRENMS_DIR}/daily.sh" 2>&1 |
            tee "${DAILY_OUTPUT_LOG}"
    else
        run_as_librenms /bin/bash "${LIBRENMS_DIR}/daily.sh" 2>&1 |
            tee "${DAILY_OUTPUT_LOG}"
    fi

    return "${PIPESTATUS[0]}"
}

daily_output_has_repairable_update_failure() {
    [ -s "${DAILY_OUTPUT_LOG}" ] || return 1
    grep -Eiq \
        'cannot lock ref|unable to create .+\.lock|Fetching new release information[[:space:]]+FAIL|Updating to latest release[[:space:]]+FAIL' \
        "${DAILY_OUTPUT_LOG}"
}

run_pre_upgrade_backup() {
    if [ "${PRE_UPGRADE_BACKUP_ENABLED}" != "true" ]; then
        return 0
    fi

    if [ ! -x "${BACKUP_WRAPPER}" ]; then
        log "pre-upgrade backup wrapper is not installed at ${BACKUP_WRAPPER}"
        [ "${PRE_UPGRADE_BACKUP_REQUIRED}" != "true" ]
        return $?
    fi

    log "running pre-upgrade backup"
    if "${BACKUP_WRAPPER}" pre-upgrade; then
        return 0
    fi

    log "pre-upgrade backup failed"
    [ "${PRE_UPGRADE_BACKUP_REQUIRED}" != "true" ]
}

check_autoload() {
    cd "${LIBRENMS_DIR}" || return 1
    run_as_librenms php -r '
        require __DIR__ . "/vendor/autoload.php";
        if (
            is_file(__DIR__ . "/LibreNMS/Util/Version.php")
            && !class_exists("LibreNMS\\Util\\Version")
        ) {
            exit(42);
        }
    '
}

composer_repair() {
    cd "${LIBRENMS_DIR}" || return 1
    log "running Composer dependency repair"
    run_as_librenms env \
        COMPOSER_PROCESS_TIMEOUT="${COMPOSER_PROCESS_TIMEOUT}" \
        COMPOSER_MEMORY_LIMIT="-1" \
        timeout "${COMPOSER_INSTALL_TIMEOUT}s" \
        ./scripts/composer_wrapper.php \
        install \
        --no-dev \
        --no-interaction \
        --no-scripts
}

clear_laravel_cache() {
    cd "${LIBRENMS_DIR}" || return 1
    run_as_librenms php artisan optimize:clear
}

restart_php_fpm() {
    if [ "${RESTART_PHP_FPM}" != "true" ] || [ -z "${PHP_FPM_SERVICE}" ]; then
        return 0
    fi

    log "restarting ${PHP_FPM_SERVICE}"
    systemctl restart "${PHP_FPM_SERVICE}"
}

post_daily_web_cache_repair() {
    [ "${CLEAR_CACHE_AFTER_DAILY}" = "true" ] || return 0

    log "clearing Laravel caches after daily maintenance"
    clear_laravel_cache || log "Laravel cache clear failed after daily maintenance"
    restart_php_fpm || log "PHP-FPM restart failed after daily maintenance"
}

clear_daily_update_failure_notification() {
    [ "${CLEAR_HEALTHY_UPDATE_FAILURE_NOTIFICATION}" = "true" ] || return 0

    local local_host
    local_host="$(hostname -s 2>/dev/null || hostname 2>/dev/null || true)"
    [ -n "${local_host}" ] || return 0

    cd "${LIBRENMS_DIR}" || return 1
    runuser -u "${LIBRENMS_USER}" -- env \
        LIBRENMS_DAILY_NODE="${local_host}" \
        LIBRENMS_DAILY_NOTIFICATION_CLEANUP_DAYS="${HEALTHY_FAILURE_NOTIFICATION_CLEANUP_DAYS}" \
        php -r '
        $init_modules = [];
        require getcwd() . "/includes/init.php";

        $node = getenv("LIBRENMS_DAILY_NODE") ?: gethostname();
        $days = max(1, (int) (getenv("LIBRENMS_DAILY_NOTIFICATION_CLEANUP_DAYS") ?: 30));
        $patterns = [
            "%failed on {$node}%",
            "%failed on " . gethostname() . "%",
        ];

        $deleted = \Illuminate\Support\Facades\DB::table("notifications")
            ->where("source", "daily.sh")
            ->where("title", "Error: Daily update failed")
            ->where("datetime", ">=", \Illuminate\Support\Facades\DB::raw("DATE_SUB(NOW(), INTERVAL {$days} DAY)"))
            ->where(function ($query) use ($patterns) {
                foreach ($patterns as $pattern) {
                    $query->orWhere("body", "like", $pattern);
                }
            })
            ->delete();

        echo $deleted, PHP_EOL;
    '
}

trap cleanup_on_exit EXIT

exec 8>"${WRAPPER_LOCK_PATH}"
if ! flock -n 8; then
    log "another daily wrapper run is already active; skipping this trigger"
    exit 0
fi

DAILY_OUTPUT_LOG="$(mktemp /tmp/librenms-daily-wrapper.XXXXXX)"

daily_rc=0
cleanup_rc=0
if git_process_active; then
    log "a LibreNMS git/composer/daily process is already active; skipping this trigger"
    exit 0
fi

acquire_cluster_maintenance_lock
cluster_lock_rc=$?
if [ "${cluster_lock_rc}" -eq 2 ]; then
    exit 0
elif [ "${cluster_lock_rc}" -ne 0 ]; then
    exit "${cluster_lock_rc}"
fi

if git_process_active; then
    log "a LibreNMS git/composer/daily process became active while acquiring the cluster lock; skipping this trigger"
    exit 0
fi

if [ "${GLOBAL_LOCK_ENABLED}" != "true" ]; then
    activate_ha_drain || exit $?
fi

cleanup_stale_git_locks || cleanup_rc=$?
if [ "${cleanup_rc}" -eq 1 ]; then
    exit 0
elif [ "${cleanup_rc}" -ne 0 ]; then
    exit "${cleanup_rc}"
fi

repair_git_metadata || log "git metadata preflight failed; continuing with daily.sh"
if [ "${GLOBAL_LOCK_ENABLED}" != "true" ]; then
    run_pre_upgrade_backup || exit $?
fi
run_daily || daily_rc=$?

if [ "${GIT_RETRY_AFTER_REPAIR}" = "true" ] && daily_output_has_repairable_update_failure; then
    log "daily.sh reported a git/update failure; repairing git metadata and retrying once"
    if repair_git_metadata; then
        daily_rc=0
        run_daily || daily_rc=$?
    else
        log "git metadata repair failed; not retrying daily.sh"
    fi
fi

post_daily_web_cache_repair

if check_autoload; then
    if [ "${daily_rc}" -eq 0 ]; then
        cleared_count="$(clear_daily_update_failure_notification 2>/dev/null | tail -n 1)" &&
            log "cleared ${cleared_count:-0} stale daily.sh failure notification(s)" ||
            log "failed to clear stale daily.sh failure notification"
    fi

    if [ "${daily_rc}" -ne 0 ]; then
        log "daily.sh failed with rc=${daily_rc}, but autoload is healthy"
        if [ "${HEALTHY_UPDATE_FAILURE_IS_SUCCESS}" = "true" ] && daily_output_has_repairable_update_failure; then
            cleared_count="$(clear_daily_update_failure_notification 2>/dev/null | tail -n 1)" &&
                log "cleared ${cleared_count:-0} matching healthy daily.sh failure notification(s)" ||
                log "failed to clear matching healthy daily.sh failure notification"
            log "treating healthy Git/release update failure as successful after self-heal checks"
            exit 0
        fi
    fi
    exit "${daily_rc}"
fi

log "autoload health check failed after daily.sh; attempting self-heal"
composer_repair || exit $?
clear_laravel_cache || true
restart_php_fpm || true

if check_autoload; then
    log "self-heal completed successfully"
    exit 0
fi

log "self-heal did not restore LibreNMS autoload health"
exit 1
