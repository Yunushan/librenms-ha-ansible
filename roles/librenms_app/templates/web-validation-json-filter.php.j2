<?php

if (PHP_SAPI !== 'fpm-fcgi') {
    return;
}

$path = parse_url($_SERVER['REQUEST_URI'] ?? '', PHP_URL_PATH) ?: '';

if (! preg_match('#/(?:index\.php/)?validate/results(?:/|$)#', $path)) {
    return;
}

$suppressTransientRrdLockErrors = {{ (librenms_web_validation_filter_transient_rrd_lock_errors | bool) | ternary('true', 'false') }};

function librenms_ha_validation_contains_rrd_lock_error(mixed $value): bool
{
    if (is_string($value)) {
        return stripos($value, 'RRD ERROR: could not lock RRD') !== false;
    }

    if (is_array($value)) {
        foreach ($value as $child) {
            if (librenms_ha_validation_contains_rrd_lock_error($child)) {
                return true;
            }
        }
    }

    return false;
}

function librenms_ha_validation_is_rrd_group(array $group): bool
{
    foreach (['group', 'name', 'title'] as $key) {
        if (isset($group[$key]) && is_string($group[$key]) && stripos($group[$key], 'rrd') !== false) {
            return true;
        }
    }

    return false;
}

function librenms_ha_validation_remove_rrd_lock_errors(array &$value, bool &$changed): bool
{
    $isList = array_is_list($value);

    foreach ($value as $key => &$child) {
        if (is_array($child)) {
            if (array_is_list($child)) {
                foreach ($child as $childKey => &$item) {
                    if (librenms_ha_validation_contains_rrd_lock_error($item)) {
                        unset($child[$childKey]);
                        $changed = true;
                    }
                }
                unset($item);

                $child = array_values($child);
            } else {
                librenms_ha_validation_remove_rrd_lock_errors($child, $changed);
            }

            continue;
        }

        if (is_string($child) && stripos($child, 'RRD ERROR: could not lock RRD') !== false) {
            unset($value[$key]);
            $changed = true;
        }
    }
    unset($child);

    if ($isList) {
        $value = array_values($value);
    }

    return librenms_ha_validation_contains_rrd_lock_error($value);
}

function librenms_ha_validation_mark_group_skipped(array &$group): void
{
    $message = 'Skipped transient RRD lock checks in HA mode';
    $group['status'] = 3;
    $group['statusText'] = 'Info';
    $group['results'] = [[
        'status' => 3,
        'statusText' => 'INFO',
        'message' => $message,
        'fix' => [],
        'fixer' => null,
        'listDescription' => '',
        'list' => [],
    ]];
}

function librenms_ha_validation_has_result_items(array $group): bool
{
    foreach (['validations', 'items', 'checks', 'results'] as $key) {
        if (array_key_exists($key, $group) && is_array($group[$key]) && count($group[$key]) > 0) {
            return true;
        }
    }

    return false;
}

ob_start(static function (string $buffer): string {
    $matched = preg_match(
        '/\[\s*\{\s*"group"\s*:/',
        $buffer,
        $jsonMatch,
        PREG_OFFSET_CAPTURE
    );

    if ($matched !== 1) {
        return $buffer;
    }

    $jsonStart = $jsonMatch[0][1];
    $payload = substr($buffer, $jsonStart);

    if (! $GLOBALS['suppressTransientRrdLockErrors']) {
        return $payload;
    }

    $results = json_decode($payload, true);

    if (! is_array($results)) {
        return $payload;
    }

    $changed = false;

    foreach ($results as &$group) {
        if (! is_array($group) || ! librenms_ha_validation_is_rrd_group($group)) {
            continue;
        }

        $groupChanged = false;
        librenms_ha_validation_remove_rrd_lock_errors($group, $groupChanged);

        if ($groupChanged) {
            $changed = true;
        }

        if (
            $groupChanged
            && ! librenms_ha_validation_contains_rrd_lock_error($group)
            && ! librenms_ha_validation_has_result_items($group)
        ) {
            librenms_ha_validation_mark_group_skipped($group);
        }
    }
    unset($group);

    if (! $changed) {
        return $payload;
    }

    return json_encode($results, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?: $payload;
});
