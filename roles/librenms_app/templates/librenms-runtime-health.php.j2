<?php

declare(strict_types=1);

/*
 * Keep this endpoint intentionally small and non-sensitive. HAProxy uses it to
 * stop routing users to PHP-FPM workers that cannot make a safe database query.
 */
$init_modules = [];

header('Content-Type: text/plain; charset=utf-8');
header('Cache-Control: no-store');

try {
    require dirname(__DIR__) . '/includes/init.php';

    $result = \Illuminate\Support\Facades\DB::selectOne('SELECT 1 AS ready');

    if ((int) ($result->ready ?? 0) !== 1) {
        throw new RuntimeException('database readiness query returned an unexpected result');
    }

{% if librenms_redis_mode == 'sentinel' %}
    $sessionDriver = (string) config('session.driver');
    $sessionConnection = (string) config('session.connection');

    if ($sessionDriver !== 'redis' || $sessionConnection !== 'sentinel_session') {
        throw new RuntimeException('the HA session store is not configured for Redis Sentinel');
    }

    app('redis')->connection($sessionConnection)->command('ping', []);

{% endif %}
{% if
  librenms_db_mode == 'galera'
  and librenms_db_host | length == 0
  and librenms_runtime_db_prefer_local_galera | bool
  and inventory_hostname in librenms_active_db_nodes
%}
    $galeraRows = \Illuminate\Support\Facades\DB::select(
        "SHOW GLOBAL STATUS WHERE Variable_name IN "
        . "('wsrep_cluster_status','wsrep_ready','wsrep_local_state_comment')"
    );
    $galeraStatus = [];

    foreach ($galeraRows as $row) {
        $name = (string) ($row->Variable_name ?? '');
        $galeraStatus[$name] = (string) ($row->Value ?? '');
    }

    if (
        ($galeraStatus['wsrep_cluster_status'] ?? '') !== 'Primary'
        || ($galeraStatus['wsrep_ready'] ?? '') !== 'ON'
        || ($galeraStatus['wsrep_local_state_comment'] ?? '') !== 'Synced'
    ) {
        throw new RuntimeException('local Galera member is not ready for application traffic');
    }

{% endif %}
    http_response_code(200);
    echo "ok\n";
} catch (Throwable) {
    http_response_code(503);
    echo "unavailable\n";
}
