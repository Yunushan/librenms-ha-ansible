#!/bin/bash
set -u

LOCK_FILE=/run/librenms-ha-startup-repair.lock
exec 9>"${LOCK_FILE}"
flock -n 9 || exit 0

LIBRENMS_DIR={{ librenms_install_dir | quote }}
LIBRENMS_USER={{ librenms_user | quote }}
LIBRENMS_GROUP={{ librenms_group | quote }}
RRD_MODE={{ librenms_rrd_mode | quote }}
RRD_PATH={{ librenms_rrdcached_base_path | quote }}
RRD_PERMISSION_REPAIR={{ librenms_rrd_permission_repair_path | quote }}
GLUSTER_MOUNT_WAIT={{ librenms_startup_repair_gluster_mount_wait | int }}
GLUSTER_STALE_MOUNT_RECOVERY={{ (librenms_gluster_recover_stale_client_mounts | bool) | ternary('1', '0') }}
GLUSTER_MOUNT_HEALTH_TIMEOUT={{ librenms_gluster_mount_health_timeout | int }}
GLUSTER_MOUNT_HEALTH_RETRIES={{ librenms_gluster_mount_health_retries | int }}
GLUSTER_MOUNT_HEALTH_RETRY_DELAY={{ librenms_gluster_mount_health_retry_delay | int }}
GLUSTER_STALE_UNMOUNT_TIMEOUT={{ librenms_gluster_stale_unmount_timeout | int }}
RRDCACHED_SERVICE={{ librenms_rrdcached_service_name | quote }}
RUNTIME_RETRIES={{ librenms_startup_repair_runtime_retries | int }}
RUNTIME_DELAY={{ librenms_startup_repair_runtime_delay | int }}
FIX_GIT_RRD_PLACEHOLDER={{ (librenms_startup_repair_fix_git_rrd_placeholder | bool) | ternary('1', '0') }}
FIX_WRITABLE_OWNERSHIP={{ (librenms_startup_repair_fix_writable_ownership | bool) | ternary('1', '0') }}
SERVICE_RECOVERY_ENABLED={{ (librenms_startup_repair_service_recovery_enabled | bool) | ternary('1', '0') }}
SERVICE_RECOVERY_TIMEOUT={{ librenms_startup_repair_service_recovery_timeout | int }}
SERVICE_RECOVERY_DELAY={{ librenms_startup_repair_service_recovery_delay | int }}
PHP_FPM_SERVICE={{ librenms_php_fpm_service_effective | default(librenms_php_fpm_service_name | default('')) | quote }}
RESTART_PHP_FPM_ON_DB_GONE_AWAY={{ (librenms_startup_repair_restart_php_fpm_on_db_gone_away | bool) | ternary('1', '0') }}
RELOAD_PHP_FPM_AFTER_DB_RECOVERY={{ (librenms_startup_repair_reload_php_fpm_after_db_recovery | bool) | ternary('1', '0') }}
DB_READINESS_MARKER={{ librenms_startup_repair_db_readiness_marker | quote }}
DB_GONE_AWAY_LOG_LINES={{ librenms_startup_repair_db_gone_away_log_lines | int }}
DB_GONE_AWAY_MARKER={{ librenms_startup_repair_db_gone_away_marker | quote }}
DB_GONE_AWAY_DB_CHECK_TIMEOUT={{ librenms_startup_repair_db_gone_away_db_check_timeout | int }}
DB_GONE_AWAY_PHP_FPM_COOLDOWN={{ librenms_startup_repair_db_gone_away_php_fpm_cooldown | int }}
DB_MODE={{ librenms_db_mode | quote }}
DB_PORT={{ librenms_db_port | int }}
DB_USER={{ librenms_db_user | quote }}
DB_PASSWORD={{ librenms_db_password | quote }}
MARIADB_SERVICE={{ librenms_mariadb_service_name | quote }}
MARIADB_SOCKET={{ librenms_mariadb_socket | quote }}
GALERA_SELF_HEAL_ENABLED={{ (librenms_galera_self_heal_enabled | bool) | ternary('1', '0') }}
GALERA_SELF_HEAL_FAILURE_THRESHOLD={{ librenms_galera_self_heal_failure_threshold | int }}
GALERA_SELF_HEAL_RESTART_COOLDOWN={{ librenms_galera_self_heal_restart_cooldown | int }}
GALERA_SELF_HEAL_STATE_DIR={{ librenms_galera_self_heal_state_dir | quote }}
GALERA_SELF_HEAL_MIN_HEALTHY_PEERS={{ ((librenms_active_db_nodes | length) / 2) | round(0, 'ceil') | int }}
GALERA_SELF_HEAL_LOCAL_MEMBER={{ (inventory_hostname in librenms_active_db_nodes) | ternary('1', '0') }}
GALERA_PEERS=(
{% for host in librenms_active_db_nodes | difference([inventory_hostname]) %}
  {{ hostvars[host].ansible_host | default(host) | quote }}
{% endfor %}
)
SERVICE_RECOVERY_UNITS=(
{% for unit in librenms_startup_repair_service_recovery_units | default([]) %}
{% set rendered_unit = unit | trim %}
{% if rendered_unit | length > 0 %}
  {{ rendered_unit | quote }}
{% endif %}
{% endfor %}
)

log() {
  echo "librenms-ha-startup-repair: $*"
}

run_as_librenms() {
  runuser -u "${LIBRENMS_USER}" -- "$@"
}

rrd_mount_present() {
  findmnt --noheadings --output TARGET --nocanonicalize \
    --mountpoint "${RRD_PATH}" >/dev/null 2>&1
}

rrd_path_accessible() {
  local attempt=1

  while [ "${attempt}" -le "${GLUSTER_MOUNT_HEALTH_RETRIES}" ]; do
    if timeout "${GLUSTER_MOUNT_HEALTH_TIMEOUT}" stat --dereference \
        --format=%F -- "${RRD_PATH}" >/dev/null 2>&1; then
      return 0
    fi
    if [ "${attempt}" -lt "${GLUSTER_MOUNT_HEALTH_RETRIES}" ]; then
      sleep "${GLUSTER_MOUNT_HEALTH_RETRY_DELAY}"
    fi
    attempt=$((attempt + 1))
  done

  return 1
}

prepare_rrd_mountpoint() {
  if [ -L "${RRD_PATH}" ]; then
    unlink -- "${RRD_PATH}" || return 1
  elif [ -e "${RRD_PATH}" ] && [ ! -d "${RRD_PATH}" ]; then
    log "refusing non-directory RRD mountpoint ${RRD_PATH}"
    return 1
  fi

  mkdir -p -- "${RRD_PATH}"
}

recover_stale_rrd_mount() {
  rrd_mount_present || return 0
  rrd_path_accessible && return 0
  [ "${GLUSTER_STALE_MOUNT_RECOVERY}" = "1" ] || return 1

  local restart_rrdcached=0
  if systemctl is-active --quiet "${RRDCACHED_SERVICE}"; then
    restart_rrdcached=1
    systemctl stop "${RRDCACHED_SERVICE}" || return 1
  fi

  log "detaching inaccessible Gluster RRD mount ${RRD_PATH}"
  if ! timeout "${GLUSTER_STALE_UNMOUNT_TIMEOUT}" \
      umount --lazy -- "${RRD_PATH}"; then
    return 1
  fi

  rrd_mount_present && return 1
  prepare_rrd_mountpoint || return 1
  mount "${RRD_PATH}" >/dev/null 2>&1 || return 1
  rrd_mount_present || return 1
  rrd_path_accessible || return 1

  if [ "${restart_rrdcached}" = "1" ]; then
    systemctl start "${RRDCACHED_SERVICE}" || return 1
  fi

  log "restored accessible Gluster RRD mount ${RRD_PATH}"
}

wait_for_rrd_mount() {
  [ "${RRD_MODE}" = "glusterfs" ] || return 0

  local deadline=$((SECONDS + GLUSTER_MOUNT_WAIT))
  while [ "${SECONDS}" -lt "${deadline}" ]; do
    if rrd_mount_present; then
      recover_stale_rrd_mount && return 0
      sleep 2
      continue
    fi

    prepare_rrd_mountpoint || return 1
    mount "${RRD_PATH}" >/dev/null 2>&1 || true
    sleep 2
  done

  log "RRD path ${RRD_PATH} is not mounted after ${GLUSTER_MOUNT_WAIT}s"
  return 1
}

recover_systemd_units() {
  [ "${SERVICE_RECOVERY_ENABLED}" = "1" ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0

  local deadline
  local pending
  local state
  local unit
  deadline=$((SECONDS + SERVICE_RECOVERY_TIMEOUT))

  while true; do
    pending=0
    for unit in "${SERVICE_RECOVERY_UNITS[@]}"; do
      [ -n "${unit}" ] || continue
      systemctl list-unit-files "${unit}" >/dev/null 2>&1 || continue

      state=$(systemctl is-active "${unit}" 2>/dev/null || true)
      if [ "${state}" != "active" ]; then
        pending=1
        log "starting ${unit} (state=${state:-unknown})"
        systemctl reset-failed "${unit}" >/dev/null 2>&1 || true
        systemctl start "${unit}" >/dev/null 2>&1 || true
      fi
    done

    [ "${pending}" -eq 0 ] && return 0
    if [ "${SECONDS}" -ge "${deadline}" ]; then
      log "service recovery still has inactive units after ${SERVICE_RECOVERY_TIMEOUT}s"
      return 1
    fi
    sleep "${SERVICE_RECOVERY_DELAY}"
  done
}

repair_writable_path() {
  local path=$1
  [ -e "${path}" ] || return 0

  if find "${path}" -xdev \( ! -user "${LIBRENMS_USER}" -o ! -group "${LIBRENMS_GROUP}" \) \
    -print -quit 2>/dev/null | grep -q .; then
    log "fixing ownership under ${path}"
    find "${path}" -xdev \( ! -user "${LIBRENMS_USER}" -o ! -group "${LIBRENMS_GROUP}" \) \
      -exec chown -h "${LIBRENMS_USER}:${LIBRENMS_GROUP}" {} + || return 1
  fi

  chmod ug+rwx "${path}" >/dev/null 2>&1 || true
  find "${path}" -xdev -type d \( ! -perm -2770 -o -perm /0007 \) \
    -exec chmod u+rwx,g+rwxs,o-rwx {} + >/dev/null 2>&1 || true
  find "${path}" -xdev -type f \( ! -perm -0660 -o -perm /0007 \) \
    -exec chmod u+rw,g+rw,o-rwx {} + >/dev/null 2>&1 || true
  if command -v setfacl >/dev/null 2>&1; then
    setfacl -m "g:${LIBRENMS_GROUP}:rwx" "${path}" >/dev/null 2>&1 || true
    setfacl -d -m "g:${LIBRENMS_GROUP}:rwx" "${path}" >/dev/null 2>&1 || true
  fi
}

repair_writable_paths() {
  [ "${FIX_WRITABLE_OWNERSHIP}" = "1" ] || return 0

  if [ -x "${RRD_PERMISSION_REPAIR}" ]; then
    "${RRD_PERMISSION_REPAIR}" || true
  else
    repair_writable_path "${LIBRENMS_DIR}/rrd" || true
  fi
  repair_writable_path "${LIBRENMS_DIR}/logs" || true
  repair_writable_path "${LIBRENMS_DIR}/bootstrap/cache" || true
  repair_writable_path "${LIBRENMS_DIR}/storage" || true
}

repair_git_rrd_placeholder() {
  [ "${FIX_GIT_RRD_PLACEHOLDER}" = "1" ] || return 0
  [ -d "${LIBRENMS_DIR}/.git" ] || return 0

  if run_as_librenms git -C "${LIBRENMS_DIR}" status --porcelain -- rrd/.gitignore \
    | grep -q .; then
    log "restoring tracked rrd/.gitignore"
    run_as_librenms git -C "${LIBRENMS_DIR}" checkout -- rrd/.gitignore >/dev/null 2>&1 || true
  fi
}

ensure_systemd_units() {
  systemctl daemon-reload >/dev/null 2>&1 || true

  for unit in \
    librenms.service \
    librenms-scheduler.timer \
    librenms-daily.timer \
    librenms-dispatcher-ha-recover.timer; do
    if systemctl list-unit-files "${unit}" >/dev/null 2>&1; then
      systemctl enable --now "${unit}" >/dev/null 2>&1 || true
    fi
  done
}

configure_librenms_runtime() {
  local attempt
  local current_value
  for attempt in $(seq 1 "${RUNTIME_RETRIES}"); do
    current_value=$(run_as_librenms "${LIBRENMS_DIR}/lnms" config:get distributed_poller 2>/dev/null || true)
    if echo "${current_value}" | grep -Eiq '^(true|1)$'; then
      return 0
    fi

    if run_as_librenms "${LIBRENMS_DIR}/lnms" config:set distributed_poller true >/dev/null 2>&1; then
      return 0
    fi
    sleep "${RUNTIME_DELAY}"
  done

  log "could not set distributed_poller after ${RUNTIME_RETRIES} attempts"
  return 1
}

latest_db_gone_away_error() {
  local log_file="${LIBRENMS_DIR}/logs/librenms.log"

  [ -r "${log_file}" ] || return 1

  tail -n "${DB_GONE_AWAY_LOG_LINES}" "${log_file}" 2>/dev/null \
    | grep -E 'SQLSTATE\[HY000\].*\[2006\]|MySQL server has gone away|Lost connection to MySQL server' \
    | tail -n 1
}

librenms_database_ready() {
  run_as_librenms timeout "${DB_GONE_AWAY_DB_CHECK_TIMEOUT}" \
    "${LIBRENMS_DIR}/lnms" config:get distributed_poller >/dev/null 2>&1
}

galera_status_is_ready() {
  printf '%s\n' "$1" | grep -Eq 'wsrep_cluster_status[[:space:]]+Primary' \
    && printf '%s\n' "$1" | grep -Eq 'wsrep_ready[[:space:]]+ON' \
    && printf '%s\n' "$1" | grep -Eq 'wsrep_local_state_comment[[:space:]]+Synced'
}

local_galera_status() {
  timeout "${DB_GONE_AWAY_DB_CHECK_TIMEOUT}" mysql --protocol=socket \
    --socket="${MARIADB_SOCKET}" -Nse \
    "SHOW GLOBAL STATUS WHERE Variable_name IN ('wsrep_cluster_status','wsrep_ready','wsrep_local_state_comment');" \
    2>/dev/null || true
}

peer_galera_status() {
  MYSQL_PWD="${DB_PASSWORD}" timeout "${DB_GONE_AWAY_DB_CHECK_TIMEOUT}" mysql \
    --protocol=tcp -h "$1" -P "${DB_PORT}" -u "${DB_USER}" \
    --connect-timeout="${DB_GONE_AWAY_DB_CHECK_TIMEOUT}" -Nse \
    "SHOW GLOBAL STATUS WHERE Variable_name IN ('wsrep_cluster_status','wsrep_ready','wsrep_local_state_comment');" \
    2>/dev/null || true
}

recover_persistently_unready_local_galera() {
  local local_status
  local peer
  local peer_status
  local healthy_peers=0
  local failures=0
  local previous_restart=0
  local now

  [ "${DB_MODE}" = 'galera' ] || return 0
  [ "${GALERA_SELF_HEAL_ENABLED}" = '1' ] || return 0
  [ "${GALERA_SELF_HEAL_LOCAL_MEMBER}" = '1' ] || return 0
  [ "${GALERA_SELF_HEAL_MIN_HEALTHY_PEERS}" -gt 0 ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0

  local_status=$(local_galera_status)
  if galera_status_is_ready "${local_status}"; then
    rm -f "${GALERA_SELF_HEAL_STATE_DIR}/galera-not-ready.count"
    return 0
  fi

  for peer in "${GALERA_PEERS[@]}"; do
    [ -n "${peer}" ] || continue
    peer_status=$(peer_galera_status "${peer}")
    if galera_status_is_ready "${peer_status}"; then
      healthy_peers=$((healthy_peers + 1))
    fi
  done

  if [ "${healthy_peers}" -lt "${GALERA_SELF_HEAL_MIN_HEALTHY_PEERS}" ]; then
    log "local Galera is not ready; refusing automatic restart because only ${healthy_peers} peer(s) are synced"
    rm -f "${GALERA_SELF_HEAL_STATE_DIR}/galera-not-ready.count"
    return 0
  fi

  mkdir -p "${GALERA_SELF_HEAL_STATE_DIR}" >/dev/null 2>&1 || return 0
  failures=$(cat "${GALERA_SELF_HEAL_STATE_DIR}/galera-not-ready.count" 2>/dev/null || printf '0')
  case "${failures}" in
    *[!0-9]*|'') failures=0 ;;
  esac
  failures=$((failures + 1))
  printf '%s\n' "${failures}" > "${GALERA_SELF_HEAL_STATE_DIR}/galera-not-ready.count"

  if [ "${failures}" -lt "${GALERA_SELF_HEAL_FAILURE_THRESHOLD}" ]; then
    log "local Galera is not ready with ${healthy_peers} synced peer(s); retry ${failures}/${GALERA_SELF_HEAL_FAILURE_THRESHOLD}"
    return 0
  fi

  previous_restart=$(cat "${GALERA_SELF_HEAL_STATE_DIR}/galera-restarted-at" 2>/dev/null || printf '0')
  case "${previous_restart}" in
    *[!0-9]*|'') previous_restart=0 ;;
  esac
  now=$(date +%s)
  if [ $((now - previous_restart)) -lt "${GALERA_SELF_HEAL_RESTART_COOLDOWN}" ]; then
    log "local Galera is not ready; restart cooldown is still active"
    return 0
  fi

  log "restarting persistently unready local Galera with ${healthy_peers} synced peer(s)"
  if systemctl restart "${MARIADB_SERVICE}" >/dev/null 2>&1; then
    printf '%s\n' "${now}" > "${GALERA_SELF_HEAL_STATE_DIR}/galera-restarted-at"
    rm -f "${GALERA_SELF_HEAL_STATE_DIR}/galera-not-ready.count"
  else
    log "failed to restart persistently unready local Galera"
  fi
}

mark_latest_db_gone_away_error_handled() {
  local latest_error

  latest_error=$(latest_db_gone_away_error || true)
  [ -n "${latest_error}" ] || return 0

  printf '%s\n' "${latest_error}" > "${DB_GONE_AWAY_MARKER}" 2>/dev/null || true
}

gracefully_reload_php_fpm_after_database_recovery() {
  local reason=$1
  local marker_dir
  local handled_at
  local now

  [ -n "${PHP_FPM_SERVICE}" ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0

  marker_dir=$(dirname "${DB_GONE_AWAY_MARKER}")
  mkdir -p "${marker_dir}" >/dev/null 2>&1 || true
  handled_at=$(cat "${DB_GONE_AWAY_MARKER}.handled-at" 2>/dev/null || printf '0')
  case "${handled_at}" in
    *[!0-9]*|'') handled_at=0 ;;
  esac
  now=$(date +%s)
  if [ $((now - handled_at)) -lt "${DB_GONE_AWAY_PHP_FPM_COOLDOWN}" ]; then
    log "${reason}; PHP-FPM recovery cooldown is active"
    return 75
  fi

  log "${reason}; gracefully reloading ${PHP_FPM_SERVICE}"
  if systemctl reload "${PHP_FPM_SERVICE}" >/dev/null 2>&1; then
    printf '%s\n' "${now}" > "${DB_GONE_AWAY_MARKER}.handled-at" 2>/dev/null || true
    return 0
  else
    log "failed to reload ${PHP_FPM_SERVICE} after database recovery"
    return 1
  fi
}

recover_php_fpm_after_db_recovery() {
  local previous_state
  local marker_dir

  [ "${RELOAD_PHP_FPM_AFTER_DB_RECOVERY}" = "1" ] || return 0
  [ -n "${PHP_FPM_SERVICE}" ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0

  marker_dir=$(dirname "${DB_READINESS_MARKER}")
  mkdir -p "${marker_dir}" >/dev/null 2>&1 || return 0
  previous_state=$(cat "${DB_READINESS_MARKER}" 2>/dev/null || true)

  if ! librenms_database_ready; then
    if [ "${previous_state}" != "unready" ]; then
      log "LibreNMS database frontend became unready; waiting for safe recovery"
    fi
    printf 'unready\n' > "${DB_READINESS_MARKER}" 2>/dev/null || true
    return 0
  fi

  if [ -z "${previous_state}" ]; then
    printf 'ready\n' > "${DB_READINESS_MARKER}" 2>/dev/null || true
    return 0
  fi

  if [ "${previous_state}" != "unready" ]; then
    printf 'ready\n' > "${DB_READINESS_MARKER}" 2>/dev/null || true
    return 0
  fi

  if gracefully_reload_php_fpm_after_database_recovery \
    "LibreNMS database frontend recovered"; then
    printf 'ready\n' > "${DB_READINESS_MARKER}" 2>/dev/null || true
    mark_latest_db_gone_away_error_handled
  fi
}

recover_php_fpm_after_db_gone_away() {
  local latest_error
  local handled_error

  [ "${RESTART_PHP_FPM_ON_DB_GONE_AWAY}" = "1" ] || return 0
  [ -n "${PHP_FPM_SERVICE}" ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0

  latest_error=$(latest_db_gone_away_error || true)
  [ -n "${latest_error}" ] || return 0

  handled_error=$(cat "${DB_GONE_AWAY_MARKER}" 2>/dev/null || true)
  [ "${latest_error}" != "${handled_error}" ] || return 0

  if ! librenms_database_ready; then
    log "detected LibreNMS DB gone-away error, but database is not ready yet"
    return 0
  fi

  if gracefully_reload_php_fpm_after_database_recovery \
    "detected fresh LibreNMS DB gone-away error"; then
    printf '%s\n' "${latest_error}" > "${DB_GONE_AWAY_MARKER}" 2>/dev/null || true
  fi
}

recover_php_fpm_after_db_recovery || true
recover_systemd_units || true
wait_for_rrd_mount || true
repair_writable_paths
repair_git_rrd_placeholder
ensure_systemd_units
recover_persistently_unready_local_galera || true
recover_php_fpm_after_db_recovery || true
if librenms_database_ready; then
  configure_librenms_runtime || true
fi
recover_php_fpm_after_db_gone_away || true

exit 0
