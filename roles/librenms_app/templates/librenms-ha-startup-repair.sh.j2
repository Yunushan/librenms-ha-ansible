#!/bin/bash
set -u

LOCK_FILE=/run/librenms-ha-startup-repair.lock
exec 9>"${LOCK_FILE}"
flock -n 9 || exit 0

LIBRENMS_DIR={{ librenms_install_dir | quote }}
LIBRENMS_USER={{ librenms_user | quote }}
LIBRENMS_GROUP={{ librenms_group | quote }}
RRD_MODE={{ librenms_rrd_mode | quote }}
RRD_PATH={{ librenms_rrdcached_base_path | quote }}
RRD_PERMISSION_REPAIR={{ librenms_rrd_permission_repair_path | quote }}
GLUSTER_MOUNT_WAIT={{ librenms_startup_repair_gluster_mount_wait | int }}
GLUSTER_STALE_MOUNT_RECOVERY={{ (librenms_gluster_recover_stale_client_mounts | bool) | ternary('1', '0') }}
GLUSTER_MOUNT_HEALTH_TIMEOUT={{ librenms_gluster_mount_health_timeout | int }}
GLUSTER_MOUNT_ATTEMPT_TIMEOUT={{ librenms_gluster_mount_attempt_timeout | int }}
GLUSTER_MOUNT_HEALTH_RETRIES={{ librenms_gluster_mount_health_retries | int }}
GLUSTER_MOUNT_HEALTH_RETRY_DELAY={{ librenms_gluster_mount_health_retry_delay | int }}
GLUSTER_STALE_UNMOUNT_TIMEOUT={{ librenms_gluster_stale_unmount_timeout | int }}
RRDCACHED_SERVICE={{ librenms_rrdcached_service_name | quote }}
RRDCACHED_REQUIRED={{ (librenms_manage_rrdcached | bool) | ternary('1', '0') }}
RUNTIME_RETRIES={{ librenms_startup_repair_runtime_retries | int }}
RUNTIME_DELAY={{ librenms_startup_repair_runtime_delay | int }}
FIX_GIT_RRD_PLACEHOLDER={{ (librenms_startup_repair_fix_git_rrd_placeholder | bool) | ternary('1', '0') }}
FIX_WRITABLE_OWNERSHIP={{ (librenms_startup_repair_fix_writable_ownership | bool) | ternary('1', '0') }}
SERVICE_RECOVERY_ENABLED={{ (librenms_startup_repair_service_recovery_enabled | bool) | ternary('1', '0') }}
SERVICE_RECOVERY_TIMEOUT={{ librenms_startup_repair_service_recovery_timeout | int }}
SERVICE_RECOVERY_DELAY={{ librenms_startup_repair_service_recovery_delay | int }}
PHP_FPM_SERVICE={{ librenms_php_fpm_service_effective | default(librenms_php_fpm_service_name | default('')) | quote }}
PHP_FPM_REQUIRED={{ (librenms_manage_php_fpm | bool) | ternary('1', '0') }}
RESTART_PHP_FPM_ON_DB_GONE_AWAY={{ (librenms_startup_repair_restart_php_fpm_on_db_gone_away | bool) | ternary('1', '0') }}
RELOAD_PHP_FPM_AFTER_DB_RECOVERY={{ (librenms_startup_repair_reload_php_fpm_after_db_recovery | bool) | ternary('1', '0') }}
DB_READINESS_MARKER={{ librenms_startup_repair_db_readiness_marker | quote }}
DB_GONE_AWAY_LOG_LINES={{ librenms_startup_repair_db_gone_away_log_lines | int }}
DB_GONE_AWAY_MARKER={{ librenms_startup_repair_db_gone_away_marker | quote }}
DB_GONE_AWAY_DB_CHECK_TIMEOUT={{ librenms_startup_repair_db_gone_away_db_check_timeout | int }}
DB_GONE_AWAY_PHP_FPM_COOLDOWN={{ librenms_startup_repair_db_gone_away_php_fpm_cooldown | int }}
DB_MODE={{ librenms_db_mode | quote }}
DB_PORT={{ librenms_db_port | int }}
DB_USER={{ librenms_db_user | quote }}
DB_PASSWORD={{ librenms_db_password | quote }}
DB_HOST={{ librenms_db_host_effective | quote }}
DB_NAME={{ librenms_db_name | quote }}
LOCAL_DB_ADDRESS={{ ansible_host | default(ansible_facts.default_ipv4.address | default(inventory_hostname)) | quote }}
MARIADB_SERVICE={{ librenms_mariadb_service_name | quote }}
MARIADB_SOCKET={{ librenms_mariadb_socket | quote }}
SYSTEMD_ACTION_TIMEOUT={{ librenms_startup_repair_systemd_action_timeout | int }}
LOAD_BALANCER_ENABLED={{ (librenms_startup_repair_load_balancer_enabled | bool) | ternary('1', '0') }}
LOAD_BALANCER_SERVICE={{ librenms_haproxy_service_name | quote }}
LOAD_BALANCER_CONFIG={{ librenms_startup_repair_load_balancer_config_path | quote }}
LOAD_BALANCER_ADDRESS={{ librenms_vip_ip | quote }}
LOAD_BALANCER_DB_PORT={{ librenms_haproxy_db_port | int }}
LOAD_BALANCER_PROBE_TIMEOUT={{ librenms_startup_repair_load_balancer_probe_timeout | int }}
LOAD_BALANCER_ACTION_TIMEOUT={{ librenms_startup_repair_load_balancer_action_timeout | int }}
LOAD_BALANCER_RESTART_COOLDOWN={{ librenms_startup_repair_load_balancer_restart_cooldown | int }}
LOAD_BALANCER_RESTART_MARKER={{ librenms_startup_repair_load_balancer_restart_marker | quote }}
KEEPALIVED_SERVICE={{ librenms_keepalived_service_name | quote }}
READINESS_AGENT_ENABLED={{ (librenms_startup_repair_readiness_agent_enabled | bool) | ternary('1', '0') }}
READINESS_AGENT_ADDRESS={{ ansible_host | default(ansible_facts.default_ipv4.address | default(inventory_hostname)) | quote }}
READINESS_AGENT_PORT={{ librenms_galera_readiness_agent_port | int }}
READINESS_AGENT_SOCKET_UNIT={{ librenms_galera_readiness_agent_socket_unit | quote }}
READINESS_AGENT_SERVICE_UNIT={{ librenms_galera_readiness_agent_service_unit | quote }}
READINESS_AGENT_RESET_PATH=/usr/local/sbin/librenms-galera-readiness-agent-reset
READINESS_AGENT_PROBE_TIMEOUT={{ librenms_startup_repair_readiness_agent_probe_timeout | int }}
READINESS_AGENT_FAILURE_THRESHOLD={{ librenms_startup_repair_readiness_agent_failure_threshold | int }}
READINESS_AGENT_RESTART_COOLDOWN={{ librenms_startup_repair_readiness_agent_restart_cooldown | int }}
READINESS_AGENT_RESTART_MARKER={{ librenms_startup_repair_readiness_agent_restart_marker | quote }}
GALERA_SELF_HEAL_ENABLED={{ (librenms_galera_self_heal_enabled | bool) | ternary('1', '0') }}
GALERA_SELF_HEAL_FAILURE_THRESHOLD={{ librenms_galera_self_heal_failure_threshold | int }}
GALERA_SELF_HEAL_RESTART_COOLDOWN={{ librenms_galera_self_heal_restart_cooldown | int }}
GALERA_SELF_HEAL_MIN_HEALTHY_PEERS={{ librenms_galera_self_heal_min_healthy_peers | int }}
GALERA_SELF_HEAL_SERVICE_ACTION_TIMEOUT={{ librenms_galera_self_heal_service_action_timeout | int }}
GALERA_SELF_HEAL_SERVICE_POLL_DELAY={{ librenms_galera_self_heal_service_poll_delay | int }}
GALERA_SELF_HEAL_DIAGNOSTIC_LINES={{ librenms_galera_self_heal_diagnostic_lines | int }}
GALERA_SELF_HEAL_STATE_DIR={{ librenms_galera_self_heal_state_dir | quote }}
GALERA_SELF_HEAL_LOCAL_MEMBER={{ (inventory_hostname in librenms_active_db_nodes) | ternary('1', '0') }}
GALERA_WEB_DRAIN_ENABLED={{ (librenms_galera_web_drain_enabled | bool) | ternary('1', '0') }}
GALERA_WEB_DRAIN_HELPER={{ librenms_galera_web_drain_helper_path | quote }}
GALERA_WEB_DRAIN_LOCAL_MEMBER={{ (inventory_hostname in (librenms_active_db_nodes | default([]))) | ternary('1', '0') }}
GALERA_PEERS=(
{% for host in librenms_active_db_nodes | difference([inventory_hostname]) %}
  {{ hostvars[host].ansible_host | default(host) | quote }}
{% endfor %}
)
SERVICE_RECOVERY_UNITS=(
{% for unit in librenms_startup_repair_service_recovery_units | default([]) %}
{% set rendered_unit = unit | trim %}
{% if rendered_unit | length > 0 %}
  {{ rendered_unit | quote }}
{% endif %}
{% endfor %}
)

log() {
  echo "librenms-ha-startup-repair: $*"
}

run_as_librenms() {
  runuser -u "${LIBRENMS_USER}" -- "$@"
}

systemctl_bounded() {
  timeout --kill-after=2s "${SYSTEMD_ACTION_TIMEOUT}s" \
    systemctl "$@"
}

unit_available() {
  timeout 5 systemctl list-unit-files "$1" >/dev/null 2>&1
}

unit_state() {
  timeout 5 systemctl is-active "$1" 2>/dev/null || true
}

vip_is_local() {
  [ "${LOAD_BALANCER_ENABLED}" = "1" ] || return 1
  [ -n "${LOAD_BALANCER_ADDRESS}" ] || return 1
  command -v ip >/dev/null 2>&1 || return 1

  ip -4 -o addr show 2>/dev/null \
    | awk -v vip="${LOAD_BALANCER_ADDRESS}" '
        { split($4, address, "/"); if (address[1] == vip) found=1 }
        END { exit(found ? 0 : 1) }
      '
}

tcp_listener_present() {
  local address=$1
  local port=$2

  command -v ss >/dev/null 2>&1 || return 1
  ss -H -ltn 2>/dev/null \
    | awk -v address="${address}" -v port=":${port}" '
        {
          endpoint=$4
          if (endpoint == address port ||
              endpoint == "0.0.0.0" port ||
              endpoint == "*" port) found=1
        }
        END { exit(found ? 0 : 1) }'
}

database_tcp_ready() {
  local endpoint=$1
  local probe_timeout=${2:-${LOAD_BALANCER_PROBE_TIMEOUT}}
  [ -n "${endpoint}" ] || return 1
  command -v mysql >/dev/null 2>&1 || return 1

  MYSQL_PWD="${DB_PASSWORD}" timeout "${probe_timeout}s" mysql \
    --protocol=tcp -h "${endpoint}" -P "${DB_PORT}" -u "${DB_USER}" \
    --connect-timeout="${probe_timeout}" \
    --batch --skip-column-names --silent "${DB_NAME}" -e 'SELECT 1' \
    2>/dev/null | grep -qx '1'
}

any_db_backend_ready() {
  local endpoint
  for endpoint in "${LOCAL_DB_ADDRESS}" "${DB_HOST}" "${GALERA_PEERS[@]}"; do
    [ -n "${endpoint}" ] || continue
    database_tcp_ready "${endpoint}" && return 0
  done

  return 1
}

readiness_socket_probe() {
  command -v bash >/dev/null 2>&1 || return 1
  timeout "${READINESS_AGENT_PROBE_TIMEOUT}s" bash -c '
    exec 3<>/dev/tcp/"$1"/"$2" || exit 1
    IFS= read -r response <&3 || exit 1
    [ "${response}" = up ]
  ' _ "${READINESS_AGENT_ADDRESS}" "${READINESS_AGENT_PORT}"
}

rrd_mount_present() {
  findmnt --noheadings --output TARGET --nocanonicalize \
    --mountpoint "${RRD_PATH}" >/dev/null 2>&1
}

rrd_path_accessible() {
  local attempt=1

  while [ "${attempt}" -le "${GLUSTER_MOUNT_HEALTH_RETRIES}" ]; do
    if timeout "${GLUSTER_MOUNT_HEALTH_TIMEOUT}" stat --dereference \
        --format=%F -- "${RRD_PATH}" >/dev/null 2>&1; then
      return 0
    fi
    if [ "${attempt}" -lt "${GLUSTER_MOUNT_HEALTH_RETRIES}" ]; then
      sleep "${GLUSTER_MOUNT_HEALTH_RETRY_DELAY}"
    fi
    attempt=$((attempt + 1))
  done

  return 1
}

prepare_rrd_mountpoint() {
  if [ -L "${RRD_PATH}" ]; then
    unlink -- "${RRD_PATH}" || return 1
  elif [ -e "${RRD_PATH}" ] && [ ! -d "${RRD_PATH}" ]; then
    log "refusing non-directory RRD mountpoint ${RRD_PATH}"
    return 1
  fi

  mkdir -p -- "${RRD_PATH}"
}

mount_rrd_path() {
  timeout "${GLUSTER_MOUNT_ATTEMPT_TIMEOUT}" \
    mount "${RRD_PATH}" >/dev/null 2>&1
}

recover_stale_rrd_mount() {
  rrd_mount_present || return 0
  rrd_path_accessible && return 0
  [ "${GLUSTER_STALE_MOUNT_RECOVERY}" = "1" ] || return 1

  local restart_rrdcached=0
  if systemctl_bounded is-active --quiet "${RRDCACHED_SERVICE}"; then
    restart_rrdcached=1
    systemctl_bounded stop "${RRDCACHED_SERVICE}" || return 1
  fi

  log "detaching inaccessible Gluster RRD mount ${RRD_PATH}"
  if ! timeout "${GLUSTER_STALE_UNMOUNT_TIMEOUT}" \
      umount --lazy -- "${RRD_PATH}"; then
    return 1
  fi

  rrd_mount_present && return 1
  prepare_rrd_mountpoint || return 1
  mount_rrd_path || return 1
  rrd_mount_present || return 1
  rrd_path_accessible || return 1

  if [ "${restart_rrdcached}" = "1" ]; then
    systemctl_bounded start "${RRDCACHED_SERVICE}" || return 1
  fi

  log "restored accessible Gluster RRD mount ${RRD_PATH}"
}

wait_for_rrd_mount() {
  [ "${RRD_MODE}" = "glusterfs" ] || return 0

  local deadline=$((SECONDS + GLUSTER_MOUNT_WAIT))
  while [ "${SECONDS}" -lt "${deadline}" ]; do
    if rrd_mount_present; then
      recover_stale_rrd_mount && return 0
      sleep 2
      continue
    fi

    prepare_rrd_mountpoint || return 1
    mount_rrd_path || true
    sleep 2
  done

  log "RRD path ${RRD_PATH} is not mounted after ${GLUSTER_MOUNT_WAIT}s"
  return 1
}

recover_systemd_units() {
  [ "${SERVICE_RECOVERY_ENABLED}" = "1" ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0

  local deadline
  local pending
  local state
  local unit
  deadline=$((SECONDS + SERVICE_RECOVERY_TIMEOUT))

  while true; do
    pending=0
    for unit in "${SERVICE_RECOVERY_UNITS[@]}"; do
      [ -n "${unit}" ] || continue
      # Galera needs peer-aware recovery. Never let the generic unit loop
      # bypass the quorum guard in recover_persistently_unready_local_galera.
      if [ "${DB_MODE}" = "galera" ] && [ "${unit}" = "${MARIADB_SERVICE}" ]; then
        continue
      fi
      # RRDCacheD must not start against an absent or stale shared RRD mount.
      # wait_for_rrd_mount and ensure_rrdcached handle it after mount health is
      # known, while the other HA services can recover normally here.
      if [[ "${RRD_MODE}" == glusterfs || "${RRD_MODE}" == external ]] \
        && [ "${unit}" = "${RRDCACHED_SERVICE}" ]; then
        continue
      fi
      unit_available "${unit}" || continue

      state=$(unit_state "${unit}")
      if [ "${state}" != "active" ]; then
        pending=1
        log "starting ${unit} (state=${state:-unknown})"
        systemctl_bounded reset-failed "${unit}" >/dev/null 2>&1 || true
        systemctl_bounded start "${unit}" >/dev/null 2>&1 || true
      fi
    done

    [ "${pending}" -eq 0 ] && return 0
    if [ "${SECONDS}" -ge "${deadline}" ]; then
      log "service recovery still has inactive units after ${SERVICE_RECOVERY_TIMEOUT}s"
      return 1
    fi
    sleep "${SERVICE_RECOVERY_DELAY}"
  done
}

restart_load_balancer() {
  local reason=$1
  local force_restart=${2:-0}
  local previous_restart=0
  local now
  local state
  local marker_dir

  [ "${LOAD_BALANCER_ENABLED}" = "1" ] || return 0
  unit_available "${LOAD_BALANCER_SERVICE}" || return 1

  if ! command -v haproxy >/dev/null 2>&1; then
    log "cannot repair ${LOAD_BALANCER_SERVICE}: haproxy executable is unavailable"
    return 1
  fi
  if ! timeout "${LOAD_BALANCER_ACTION_TIMEOUT}s" haproxy -c -f \
      "${LOAD_BALANCER_CONFIG}" >/dev/null 2>&1; then
    log "refusing ${LOAD_BALANCER_SERVICE} recovery because its configuration is invalid"
    return 1
  fi

  marker_dir=$(dirname "${LOAD_BALANCER_RESTART_MARKER}")
  mkdir -p "${marker_dir}" >/dev/null 2>&1 || return 1
  previous_restart=$(cat "${LOAD_BALANCER_RESTART_MARKER}" 2>/dev/null || printf '0')
  case "${previous_restart}" in
    *[!0-9]*|'') previous_restart=0 ;;
  esac
  now=$(date +%s)
  if [ $((now - previous_restart)) -lt "${LOAD_BALANCER_RESTART_COOLDOWN}" ]; then
    log "${reason}; ${LOAD_BALANCER_SERVICE} recovery cooldown is active"
    return 75
  fi

  # Record before touching HAProxy. If systemd or the kernel is slow, the
  # 30-second repair timer must not create a reload/restart storm.
  printf '%s\n' "${now}" > "${LOAD_BALANCER_RESTART_MARKER}" 2>/dev/null || true
  state=$(unit_state "${LOAD_BALANCER_SERVICE}")
  if [ "${force_restart}" = "0" ] && [ "${state}" = "active" ]; then
    log "${reason}; reloading ${LOAD_BALANCER_SERVICE}"
    if ! systemctl_bounded reload "${LOAD_BALANCER_SERVICE}" >/dev/null 2>&1; then
      log "${LOAD_BALANCER_SERVICE} reload failed; trying a bounded restart"
      systemctl_bounded restart "${LOAD_BALANCER_SERVICE}" >/dev/null 2>&1 || return 1
    fi
  else
    log "${reason}; restarting ${LOAD_BALANCER_SERVICE}"
    systemctl_bounded reset-failed "${LOAD_BALANCER_SERVICE}" >/dev/null 2>&1 || true
    systemctl_bounded restart "${LOAD_BALANCER_SERVICE}" >/dev/null 2>&1 || \
      systemctl_bounded start "${LOAD_BALANCER_SERVICE}" >/dev/null 2>&1 || return 1
  fi

  state=$(unit_state "${LOAD_BALANCER_SERVICE}")
  [ "${state}" = "active" ] || return 1
  if vip_is_local && ! tcp_listener_present "${LOAD_BALANCER_ADDRESS}" "${LOAD_BALANCER_DB_PORT}"; then
    log "${LOAD_BALANCER_SERVICE} is active but the local VIP database listener is still absent"
    return 1
  fi
}

ensure_load_balancer() {
  local state
  local keepalived_state

  [ "${LOAD_BALANCER_ENABLED}" = "1" ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0
  unit_available "${LOAD_BALANCER_SERVICE}" || return 0

  state=$(unit_state "${LOAD_BALANCER_SERVICE}")
  if [ "${state}" != "active" ]; then
    systemctl_bounded reset-failed "${LOAD_BALANCER_SERVICE}" >/dev/null 2>&1 || true
    log "starting ${LOAD_BALANCER_SERVICE} (state=${state:-unknown})"
    systemctl_bounded start "${LOAD_BALANCER_SERVICE}" >/dev/null 2>&1 || true
  fi

  if unit_available "${KEEPALIVED_SERVICE}"; then
    keepalived_state=$(unit_state "${KEEPALIVED_SERVICE}")
    if [ "${keepalived_state}" != "active" ]; then
      systemctl_bounded reset-failed "${KEEPALIVED_SERVICE}" >/dev/null 2>&1 || true
      log "starting ${KEEPALIVED_SERVICE} (state=${keepalived_state:-unknown})"
      systemctl_bounded start "${KEEPALIVED_SERVICE}" >/dev/null 2>&1 || true
    fi
  fi

  # A standby node is allowed not to own the VIP. Only the owner must expose
  # the database listener and pass an actual MySQL login probe.
  if vip_is_local; then
    if ! tcp_listener_present "${LOAD_BALANCER_ADDRESS}" "${LOAD_BALANCER_DB_PORT}"; then
      restart_load_balancer \
        "local VIP ${LOAD_BALANCER_ADDRESS} has no database listener" 1 || true
    elif ! database_tcp_ready "${LOAD_BALANCER_ADDRESS}"; then
      if any_db_backend_ready; then
        restart_load_balancer \
          "local VIP ${LOAD_BALANCER_ADDRESS} rejects database login while a Galera backend is ready" 0 || true
      else
        log "local VIP database login failed, but no Galera backend passed the direct probe; preserving cluster state"
      fi
    fi
  fi
}

ensure_readiness_agent() {
  local state
  local local_status
  local failures=0
  local previous_restart=0
  local now
  local marker_dir

  [ "${READINESS_AGENT_ENABLED}" = "1" ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0
  unit_available "${READINESS_AGENT_SOCKET_UNIT}" || return 0

  state=$(unit_state "${READINESS_AGENT_SOCKET_UNIT}")
  if [ "${state}" != "active" ]; then
    systemctl_bounded reset-failed "${READINESS_AGENT_SOCKET_UNIT}" >/dev/null 2>&1 || true
    log "starting ${READINESS_AGENT_SOCKET_UNIT} (state=${state:-unknown})"
    systemctl_bounded start "${READINESS_AGENT_SOCKET_UNIT}" >/dev/null 2>&1 || true
  fi

  readiness_socket_probe && {
    rm -f "${READINESS_AGENT_RESTART_MARKER}.failures"
    return 0
  }

  # A down response is valid while this member is joining or the cluster is
  # unavailable. Only repair the socket when MariaDB is already verified
  # Primary/ready/Synced and the transport itself is broken.
  local_status=$(local_galera_status)
  if ! galera_status_is_ready "${local_status}"; then
    rm -f "${READINESS_AGENT_RESTART_MARKER}.failures"
    return 0
  fi

  marker_dir=$(dirname "${READINESS_AGENT_RESTART_MARKER}")
  mkdir -p "${marker_dir}" >/dev/null 2>&1 || return 0
  failures=$(cat "${READINESS_AGENT_RESTART_MARKER}.failures" 2>/dev/null || printf '0')
  case "${failures}" in
    *[!0-9]*|'') failures=0 ;;
  esac
  failures=$((failures + 1))
  printf '%s\n' "${failures}" > "${READINESS_AGENT_RESTART_MARKER}.failures" 2>/dev/null || true
  if [ "${failures}" -lt "${READINESS_AGENT_FAILURE_THRESHOLD}" ]; then
    log "readiness socket is unresponsive while local Galera is ready; retry ${failures}/${READINESS_AGENT_FAILURE_THRESHOLD}"
    return 0
  fi

  previous_restart=$(cat "${READINESS_AGENT_RESTART_MARKER}" 2>/dev/null || printf '0')
  case "${previous_restart}" in
    *[!0-9]*|'') previous_restart=0 ;;
  esac
  now=$(date +%s)
  if [ $((now - previous_restart)) -lt "${READINESS_AGENT_RESTART_COOLDOWN}" ]; then
    log "readiness socket is unresponsive; readiness-agent recovery cooldown is active"
    return 0
  fi

  printf '%s\n' "${now}" > "${READINESS_AGENT_RESTART_MARKER}" 2>/dev/null || true
  log "resetting stale ${READINESS_AGENT_SOCKET_UNIT} after a healthy local Galera probe"
  if [ -x "${READINESS_AGENT_RESET_PATH}" ]; then
    timeout "${LOAD_BALANCER_ACTION_TIMEOUT}s" \
      "${READINESS_AGENT_RESET_PATH}" >/dev/null 2>&1 || true
  fi
  if ! readiness_socket_probe; then
    systemctl_bounded restart "${READINESS_AGENT_SOCKET_UNIT}" >/dev/null 2>&1 || true
  fi
  readiness_socket_probe || \
    log "${READINESS_AGENT_SOCKET_UNIT} remains unresponsive after bounded recovery"
}

repair_writable_path() {
  local path=$1
  [ -e "${path}" ] || return 0

  if find "${path}" -xdev \( ! -user "${LIBRENMS_USER}" -o ! -group "${LIBRENMS_GROUP}" \) \
    -print -quit 2>/dev/null | grep -q .; then
    log "fixing ownership under ${path}"
    find "${path}" -xdev \( ! -user "${LIBRENMS_USER}" -o ! -group "${LIBRENMS_GROUP}" \) \
      -exec chown -h "${LIBRENMS_USER}:${LIBRENMS_GROUP}" {} + || return 1
  fi

  chmod ug+rwx "${path}" >/dev/null 2>&1 || true
  find "${path}" -xdev -type d \( ! -perm -2770 -o -perm /0007 \) \
    -exec chmod u+rwx,g+rwxs,o-rwx {} + >/dev/null 2>&1 || true
  find "${path}" -xdev -type f \( ! -perm -0660 -o -perm /0007 \) \
    -exec chmod u+rw,g+rw,o-rwx {} + >/dev/null 2>&1 || true
  if command -v setfacl >/dev/null 2>&1; then
    setfacl -m "g:${LIBRENMS_GROUP}:rwx" "${path}" >/dev/null 2>&1 || true
    setfacl -d -m "g:${LIBRENMS_GROUP}:rwx" "${path}" >/dev/null 2>&1 || true
  fi
}

repair_writable_paths() {
  [ "${FIX_WRITABLE_OWNERSHIP}" = "1" ] || return 0

  if [ -x "${RRD_PERMISSION_REPAIR}" ]; then
    "${RRD_PERMISSION_REPAIR}" || true
  else
    repair_writable_path "${LIBRENMS_DIR}/rrd" || true
  fi
  repair_writable_path "${LIBRENMS_DIR}/logs" || true
  repair_writable_path "${LIBRENMS_DIR}/bootstrap/cache" || true
  repair_writable_path "${LIBRENMS_DIR}/storage" || true
}

repair_git_rrd_placeholder() {
  [ "${FIX_GIT_RRD_PLACEHOLDER}" = "1" ] || return 0
  [ -d "${LIBRENMS_DIR}/.git" ] || return 0

  if run_as_librenms git -C "${LIBRENMS_DIR}" status --porcelain -- rrd/.gitignore \
    | grep -q .; then
    log "restoring tracked rrd/.gitignore"
    run_as_librenms git -C "${LIBRENMS_DIR}" checkout -- rrd/.gitignore >/dev/null 2>&1 || true
  fi
}

ensure_systemd_units() {
  systemctl_bounded daemon-reload >/dev/null 2>&1 || true

  local runtime_ready=0
  local service_state
  local state
  local unit

  # Enablement records the desired boot state without starting an application
  # during a database, RRD, or cache outage. Starts are handled below only
  # after the complete local runtime dependency set is healthy.
  for unit in \
    librenms.service \
    librenms-scheduler.timer \
    librenms-daily.timer \
    librenms-dispatcher-ha-recover.timer; do
    if unit_available "${unit}"; then
      systemctl_bounded enable "${unit}" >/dev/null 2>&1 || true
    fi
  done

  if runtime_dependencies_ready; then
    runtime_ready=1
  fi

  if [ "${runtime_ready}" -ne 1 ]; then
    log 'database, RRD, or RRDCacheD dependencies are not ready; keeping LibreNMS application units quiesced'

    # Timers must not launch polling or maintenance jobs while the VIP/DB
    # path is unavailable. They remain enabled and will be started on the
    # next bounded repair pass after dependencies recover.
    for unit in \
      librenms-scheduler.timer \
      librenms-daily.timer \
      librenms-dispatcher-ha-recover.timer; do
      if unit_available "${unit}"; then
        state=$(unit_state "${unit}")
        case "${state}" in
          active|activating|deactivating)
            systemctl_bounded stop "${unit}" >/dev/null 2>&1 || true
            ;;
        esac
      fi
    done

    # A dispatcher stuck in its startup gate should not remain in an
    # activating loop while the database is unavailable. Do not stop a
    # healthy active dispatcher; it can reconnect when the outage clears.
    if unit_available librenms.service; then
      service_state=$(unit_state librenms.service)
      if [ "${service_state}" = activating ]; then
        log 'librenms.service is waiting on unavailable runtime dependencies; stopping its startup attempt'
        systemctl_bounded stop librenms.service >/dev/null 2>&1 || true
      fi
    fi
    return 0
  fi

  if unit_available librenms.service; then
    service_state=$(unit_state librenms.service)
    if [ "${service_state}" != active ]; then
      log "starting librenms.service after runtime dependencies were confirmed (state=${service_state:-unknown})"
      systemctl_bounded reset-failed librenms.service >/dev/null 2>&1 || true
      systemctl_bounded start librenms.service >/dev/null 2>&1 || true
    fi
  fi

  # Timers are useful only once the dispatcher is actually running. This
  # ordering prevents a recovered database from immediately spawning jobs
  # against a still-starting application service.
  if unit_available librenms.service && [ "$(unit_state librenms.service)" = active ]; then
    for unit in \
      librenms-scheduler.timer \
      librenms-daily.timer \
      librenms-dispatcher-ha-recover.timer; do
      if unit_available "${unit}"; then
        systemctl_bounded start "${unit}" >/dev/null 2>&1 || true
      fi
    done
  else
    log 'librenms.service is not active after a bounded start; leaving LibreNMS timers stopped'
  fi
}

ensure_rrdcached() {
  [ "${SERVICE_RECOVERY_ENABLED}" = "1" ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0
  unit_available "${RRDCACHED_SERVICE}" || return 0

  if [[ "${RRD_MODE}" == glusterfs || "${RRD_MODE}" == external ]]; then
    rrd_mount_present || return 0
    rrd_path_accessible || return 0
  fi

  local state
  state=$(unit_state "${RRDCACHED_SERVICE}")
  [ "${state}" = "active" ] && return 0

  log "starting ${RRDCACHED_SERVICE} after RRD readiness was confirmed (state=${state:-unknown})"
  systemctl_bounded reset-failed "${RRDCACHED_SERVICE}" >/dev/null 2>&1 || true
  systemctl_bounded start "${RRDCACHED_SERVICE}" >/dev/null 2>&1 || true
}

configure_librenms_runtime() {
  local attempt
  local current_value
  for attempt in $(seq 1 "${RUNTIME_RETRIES}"); do
    current_value=$(run_as_librenms "${LIBRENMS_DIR}/lnms" config:get distributed_poller 2>/dev/null || true)
    if echo "${current_value}" | grep -Eiq '^(true|1)$'; then
      return 0
    fi

    if run_as_librenms "${LIBRENMS_DIR}/lnms" config:set distributed_poller true >/dev/null 2>&1; then
      return 0
    fi
    sleep "${RUNTIME_DELAY}"
  done

  log "could not set distributed_poller after ${RUNTIME_RETRIES} attempts"
  return 1
}

latest_db_gone_away_error() {
  local log_file="${LIBRENMS_DIR}/logs/librenms.log"

  [ -r "${log_file}" ] || return 1

  tail -n "${DB_GONE_AWAY_LOG_LINES}" "${log_file}" 2>/dev/null \
    | grep -E 'SQLSTATE\[HY000\].*\[(2002|2006|2013)\]|MySQL server has gone away|Lost connection to MySQL server|Connection refused' \
    | tail -n 1
}

librenms_database_ready() {
  if [ "${LOAD_BALANCER_ENABLED}" = "1" ]; then
    database_tcp_ready "${DB_HOST}" "${DB_GONE_AWAY_DB_CHECK_TIMEOUT}" || return 1
  fi

  run_as_librenms timeout "${DB_GONE_AWAY_DB_CHECK_TIMEOUT}" \
    "${LIBRENMS_DIR}/lnms" config:get distributed_poller >/dev/null 2>&1
}

runtime_rrd_ready() {
  case "${RRD_MODE}" in
    glusterfs|external)
      rrd_mount_present && rrd_path_accessible
      ;;
    *)
      return 0
      ;;
  esac
}

runtime_rrdcached_ready() {
  [ "${RRDCACHED_REQUIRED}" = 1 ] || return 0
  unit_available "${RRDCACHED_SERVICE}" || return 1
  [ "$(unit_state "${RRDCACHED_SERVICE}")" = active ]
}

runtime_php_fpm_ready() {
  [ "${PHP_FPM_REQUIRED}" = 1 ] || return 0
  [ -n "${PHP_FPM_SERVICE}" ] || return 1
  unit_available "${PHP_FPM_SERVICE}" || return 1
  [ "$(unit_state "${PHP_FPM_SERVICE}")" = active ]
}

runtime_galera_ready() {
  [ "${DB_MODE}" = galera ] || return 0
  # Web-only nodes may use the VIP without running a local MariaDB member.
  [ "${GALERA_SELF_HEAL_LOCAL_MEMBER}" = 1 ] || return 0
  galera_status_is_ready "$(local_galera_status)"
}

runtime_dependencies_ready() {
  runtime_rrd_ready || return 1
  runtime_rrdcached_ready || return 1
  librenms_database_ready || return 1
  runtime_php_fpm_ready || return 1
  runtime_galera_ready || return 1
}

galera_status_is_ready() {
  printf '%s\n' "$1" | grep -Eq 'wsrep_cluster_status[[:space:]]+Primary' \
    && printf '%s\n' "$1" | grep -Eq 'wsrep_ready[[:space:]]+ON' \
    && printf '%s\n' "$1" | grep -Eq 'wsrep_local_state_comment[[:space:]]+Synced'
}

local_galera_status() {
  timeout "${DB_GONE_AWAY_DB_CHECK_TIMEOUT}" mysql --protocol=socket \
    --socket="${MARIADB_SOCKET}" -Nse \
    "SHOW GLOBAL STATUS WHERE Variable_name IN ('wsrep_cluster_status','wsrep_ready','wsrep_local_state_comment');" \
    2>/dev/null || true
}

peer_galera_status() {
  MYSQL_PWD="${DB_PASSWORD}" timeout "${DB_GONE_AWAY_DB_CHECK_TIMEOUT}" mysql \
    --protocol=tcp -h "$1" -P "${DB_PORT}" -u "${DB_USER}" \
    --connect-timeout="${DB_GONE_AWAY_DB_CHECK_TIMEOUT}" -Nse \
    "SHOW GLOBAL STATUS WHERE Variable_name IN ('wsrep_cluster_status','wsrep_ready','wsrep_local_state_comment');" \
    2>/dev/null || true
}

report_local_galera_rejoin_failure() {
  log "local Galera did not rejoin within ${GALERA_SELF_HEAL_SERVICE_ACTION_TIMEOUT}s"
  timeout 10 systemctl status --no-pager --full "${MARIADB_SERVICE}" 2>&1 \
    | tail -n "${GALERA_SELF_HEAL_DIAGNOSTIC_LINES}" || true
  timeout 10 journalctl -u "${MARIADB_SERVICE}" \
    -n "${GALERA_SELF_HEAL_DIAGNOSTIC_LINES}" --no-pager 2>&1 || true
}

wait_for_local_galera_ready() {
  local deadline=$((SECONDS + GALERA_SELF_HEAL_SERVICE_ACTION_TIMEOUT))
  local local_status
  local service_state

  while [ "${SECONDS}" -lt "${deadline}" ]; do
    local_status=$(local_galera_status)
    if galera_status_is_ready "${local_status}"; then
      return 0
    fi

    service_state=$(unit_state "${MARIADB_SERVICE}")
    if [ "${service_state}" = "failed" ]; then
      return 1
    fi

    sleep "${GALERA_SELF_HEAL_SERVICE_POLL_DELAY}"
  done

  return 1
}

enter_local_galera_web_drain() {
  [ "${GALERA_WEB_DRAIN_ENABLED}" = '1' ] || return 0
  [ "${GALERA_WEB_DRAIN_LOCAL_MEMBER}" = '1' ] || return 0

  if [ ! -x "${GALERA_WEB_DRAIN_HELPER}" ]; then
    log "refusing managed Galera restart because ${GALERA_WEB_DRAIN_HELPER} is unavailable"
    return 1
  fi

  timeout "${GALERA_SELF_HEAL_SERVICE_ACTION_TIMEOUT}" \
    "${GALERA_WEB_DRAIN_HELPER}" enter >/dev/null
}

exit_local_galera_web_drain() {
  [ "${GALERA_WEB_DRAIN_ENABLED}" = '1' ] || return 0
  [ "${GALERA_WEB_DRAIN_LOCAL_MEMBER}" = '1' ] || return 0
  [ -x "${GALERA_WEB_DRAIN_HELPER}" ] || return 1

  timeout "${GALERA_SELF_HEAL_SERVICE_ACTION_TIMEOUT}" \
    "${GALERA_WEB_DRAIN_HELPER}" exit >/dev/null
}

recover_persistently_unready_local_galera() {
  local local_status
  local peer
  local peer_status
  local healthy_peers=0
  local failures=0
  local failure_threshold
  local previous_restart=0
  local now
  local service_action
  local service_state

  [ "${DB_MODE}" = 'galera' ] || return 0
  [ "${GALERA_SELF_HEAL_ENABLED}" = '1' ] || return 0
  [ "${GALERA_SELF_HEAL_LOCAL_MEMBER}" = '1' ] || return 0
  [ "${GALERA_SELF_HEAL_MIN_HEALTHY_PEERS}" -gt 0 ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0

  service_state=$(unit_state "${MARIADB_SERVICE}")
  local_status=$(local_galera_status)
  if galera_status_is_ready "${local_status}"; then
    rm -f "${GALERA_SELF_HEAL_STATE_DIR}/galera-not-ready.count"
    if ! exit_local_galera_web_drain; then
      log 'local Galera is ready, but its web drain could not be cleared safely'
    fi
    return 0
  fi

  for peer in "${GALERA_PEERS[@]}"; do
    [ -n "${peer}" ] || continue
    peer_status=$(peer_galera_status "${peer}")
    if galera_status_is_ready "${peer_status}"; then
      healthy_peers=$((healthy_peers + 1))
    fi
  done

  if [ "${healthy_peers}" -lt "${GALERA_SELF_HEAL_MIN_HEALTHY_PEERS}" ]; then
    log "local Galera is not ready; refusing automatic restart because only ${healthy_peers} peer(s) are synced"
    rm -f "${GALERA_SELF_HEAL_STATE_DIR}/galera-not-ready.count"
    return 0
  fi

  mkdir -p "${GALERA_SELF_HEAL_STATE_DIR}" >/dev/null 2>&1 || return 0
  service_action=restart
  failure_threshold=${GALERA_SELF_HEAL_FAILURE_THRESHOLD}
  if [ "${service_state}" != "active" ]; then
    service_action=start
    failure_threshold=1
  fi

  failures=$(cat "${GALERA_SELF_HEAL_STATE_DIR}/galera-not-ready.count" 2>/dev/null || printf '0')
  case "${failures}" in
    *[!0-9]*|'') failures=0 ;;
  esac
  failures=$((failures + 1))
  printf '%s\n' "${failures}" > "${GALERA_SELF_HEAL_STATE_DIR}/galera-not-ready.count"

  if [ "${failures}" -lt "${failure_threshold}" ]; then
    log "local Galera is not ready with ${healthy_peers} synced peer(s); retry ${failures}/${failure_threshold}"
    return 0
  fi

  previous_restart=$(cat "${GALERA_SELF_HEAL_STATE_DIR}/galera-restarted-at" 2>/dev/null || printf '0')
  case "${previous_restart}" in
    *[!0-9]*|'') previous_restart=0 ;;
  esac
  now=$(date +%s)
  if [ $((now - previous_restart)) -lt "${GALERA_SELF_HEAL_RESTART_COOLDOWN}" ]; then
    log "local Galera is not ready; restart cooldown is still active"
    return 0
  fi

  if ! enter_local_galera_web_drain; then
    log 'local Galera restart was cancelled because database clients could not drain'
    return 0
  fi

  # Record the attempt before invoking systemd. A failed start must observe the
  # same cooldown as a successful one instead of creating a restart storm.
  printf '%s\n' "${now}" > "${GALERA_SELF_HEAL_STATE_DIR}/galera-restarted-at"
  log "requesting normal Galera ${service_action} with ${healthy_peers} synced peer(s)"
  systemctl_bounded reset-failed "${MARIADB_SERVICE}" >/dev/null 2>&1 || true
  if systemctl_bounded --no-block "${service_action}" "${MARIADB_SERVICE}" \
      >/dev/null 2>&1 && wait_for_local_galera_ready; then
    rm -f "${GALERA_SELF_HEAL_STATE_DIR}/galera-not-ready.count"
    if exit_local_galera_web_drain; then
      log "local Galera rejoined the existing Primary component and web traffic resumed"
    else
      log 'local Galera rejoined, but web traffic remains drained because recovery cleanup failed'
    fi
  else
    report_local_galera_rejoin_failure
  fi
}

mark_latest_db_gone_away_error_handled() {
  local latest_error

  latest_error=$(latest_db_gone_away_error || true)
  [ -n "${latest_error}" ] || return 0

  printf '%s\n' "${latest_error}" > "${DB_GONE_AWAY_MARKER}" 2>/dev/null || true
}

gracefully_reload_php_fpm_after_database_recovery() {
  local reason=$1
  local marker_dir
  local handled_at
  local now

  [ -n "${PHP_FPM_SERVICE}" ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0

  marker_dir=$(dirname "${DB_GONE_AWAY_MARKER}")
  mkdir -p "${marker_dir}" >/dev/null 2>&1 || true
  handled_at=$(cat "${DB_GONE_AWAY_MARKER}.handled-at" 2>/dev/null || printf '0')
  case "${handled_at}" in
    *[!0-9]*|'') handled_at=0 ;;
  esac
  now=$(date +%s)
  if [ $((now - handled_at)) -lt "${DB_GONE_AWAY_PHP_FPM_COOLDOWN}" ]; then
    log "${reason}; PHP-FPM recovery cooldown is active"
    return 75
  fi

  log "${reason}; gracefully reloading ${PHP_FPM_SERVICE}"
  if systemctl_bounded reload "${PHP_FPM_SERVICE}" >/dev/null 2>&1; then
    printf '%s\n' "${now}" > "${DB_GONE_AWAY_MARKER}.handled-at" 2>/dev/null || true
    return 0
  else
    log "failed to reload ${PHP_FPM_SERVICE} after database recovery"
    return 1
  fi
}

recover_php_fpm_after_db_recovery() {
  local previous_state
  local marker_dir

  [ "${RELOAD_PHP_FPM_AFTER_DB_RECOVERY}" = "1" ] || return 0
  [ -n "${PHP_FPM_SERVICE}" ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0

  marker_dir=$(dirname "${DB_READINESS_MARKER}")
  mkdir -p "${marker_dir}" >/dev/null 2>&1 || return 0
  previous_state=$(cat "${DB_READINESS_MARKER}" 2>/dev/null || true)

  if ! librenms_database_ready; then
    if [ "${previous_state}" != "unready" ]; then
      log "LibreNMS database frontend became unready; waiting for safe recovery"
    fi
    printf 'unready\n' > "${DB_READINESS_MARKER}" 2>/dev/null || true
    return 0
  fi

  if [ -z "${previous_state}" ]; then
    printf 'ready\n' > "${DB_READINESS_MARKER}" 2>/dev/null || true
    return 0
  fi

  if [ "${previous_state}" != "unready" ]; then
    printf 'ready\n' > "${DB_READINESS_MARKER}" 2>/dev/null || true
    return 0
  fi

  if gracefully_reload_php_fpm_after_database_recovery \
    "LibreNMS database frontend recovered"; then
    printf 'ready\n' > "${DB_READINESS_MARKER}" 2>/dev/null || true
    mark_latest_db_gone_away_error_handled
  fi
}

recover_php_fpm_after_db_gone_away() {
  local latest_error
  local handled_error

  [ "${RESTART_PHP_FPM_ON_DB_GONE_AWAY}" = "1" ] || return 0
  [ -n "${PHP_FPM_SERVICE}" ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0

  latest_error=$(latest_db_gone_away_error || true)
  [ -n "${latest_error}" ] || return 0

  handled_error=$(cat "${DB_GONE_AWAY_MARKER}" 2>/dev/null || true)
  [ "${latest_error}" != "${handled_error}" ] || return 0

  if ! librenms_database_ready; then
    log "detected LibreNMS DB gone-away error, but database is not ready yet"
    return 0
  fi

  if gracefully_reload_php_fpm_after_database_recovery \
    "detected fresh LibreNMS DB gone-away error"; then
    printf '%s\n' "${latest_error}" > "${DB_GONE_AWAY_MARKER}" 2>/dev/null || true
  fi
}

recover_php_fpm_after_db_recovery || true
ensure_readiness_agent || true
ensure_load_balancer || true
recover_persistently_unready_local_galera || true
ensure_readiness_agent || true
recover_systemd_units || true
wait_for_rrd_mount || true
repair_writable_paths
repair_git_rrd_placeholder
ensure_rrdcached || true
ensure_systemd_units
ensure_readiness_agent || true
ensure_load_balancer || true
recover_php_fpm_after_db_recovery || true
if librenms_database_ready; then
  configure_librenms_runtime || true
fi
recover_php_fpm_after_db_gone_away || true

exit 0
