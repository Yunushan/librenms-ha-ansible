{% set librenms_nginx_listen =
  (
    (ansible_host | default(ansible_default_ipv4.address | default(inventory_hostname))) ~ ':80'
  )
  if inventory_hostname in (
    groups.get('lb_nodes', [])
    | difference(librenms_inactive_inventory_nodes)
  )
  else '80'
%}
{% if librenms_nginx_redirect_unmatched_hosts | bool %}
server {
    listen {{ librenms_nginx_listen }} default_server;
    server_name _;

    location = {{ librenms_nginx_health_check_path }} {
        access_log off;
{% if librenms_daily_ha_drain_enabled | bool %}
        if (-f {{ librenms_daily_ha_drain_path }}) {
            return 503;
        }
{% endif %}
{% if librenms_galera_web_drain_enabled | bool %}
        if (-f {{ librenms_galera_web_drain_path }}) {
            return 503;
        }
{% endif %}
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 {{ librenms_app_url_effective | regex_replace('/$', '') }}$request_uri;
    }
}

{% endif %}
server {
    listen {{ librenms_nginx_listen }};
    server_name {{ librenms_nginx_server_names_effective | default('_') }};
    root {{ librenms_install_dir }}/html;
    index index.php;

    charset utf-8;
    gzip on;
    gzip_types
        text/css application/javascript text/javascript application/x-javascript
        image/svg+xml text/plain text/xsd text/xsl text/xml image/x-icon;

    location = {{ librenms_nginx_health_check_path }} {
        access_log off;
{% if librenms_daily_ha_drain_enabled | bool %}
        if (-f {{ librenms_daily_ha_drain_path }}) {
            return 503;
        }
{% endif %}
{% if librenms_galera_web_drain_enabled | bool %}
        if (-f {{ librenms_galera_web_drain_path }}) {
            return 503;
        }
{% endif %}
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

{% if (librenms_daily_ha_drain_enabled | bool or librenms_galera_web_drain_enabled | bool) and librenms_haproxy_web_check_path != librenms_nginx_health_check_path %}
    location = {{ librenms_haproxy_web_check_path }} {
        if (-f {{ librenms_daily_ha_drain_path }}) {
            return 503;
        }
{% if librenms_galera_web_drain_enabled | bool %}
        if (-f {{ librenms_galera_web_drain_path }}) {
            return 503;
        }
{% endif %}

        try_files $uri $uri/ /index.php?$query_string;
    }
{% endif %}

{% if librenms_manage_web_runtime_health_probe | bool %}
    location = {{ librenms_nginx_runtime_health_check_path }} {
        access_log off;
{% if librenms_daily_ha_drain_enabled | bool %}
        if (-f {{ librenms_daily_ha_drain_path }}) {
            return 503;
        }
{% endif %}
{% if librenms_galera_web_drain_enabled | bool %}
        if (-f {{ librenms_galera_web_drain_path }}) {
            return 503;
        }
{% endif %}
        include fastcgi.conf;
        fastcgi_param SCRIPT_FILENAME {{ librenms_web_runtime_health_probe_path }};
        fastcgi_param SCRIPT_NAME {{ librenms_nginx_runtime_health_check_path }};
        fastcgi_connect_timeout {{ librenms_nginx_fastcgi_connect_timeout }};
        fastcgi_send_timeout {{ librenms_nginx_fastcgi_send_timeout }};
        fastcgi_read_timeout {{ librenms_nginx_fastcgi_read_timeout }};
        fastcgi_pass unix:{{ librenms_php_fpm_socket }};
    }
{% endif %}

    location = {{ librenms_php_fpm_ping_path }} {
        access_log off;
        include fastcgi.conf;
        fastcgi_connect_timeout {{ librenms_nginx_fastcgi_connect_timeout }};
        fastcgi_send_timeout {{ librenms_nginx_fastcgi_send_timeout }};
        fastcgi_read_timeout {{ librenms_nginx_fastcgi_read_timeout }};
        fastcgi_pass unix:{{ librenms_php_fpm_socket }};
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~* ^/(?:index\.php/)?validate/results/rrdcheck/?$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param PHP_VALUE "max_execution_time={{ librenms_php_fpm_web_validation_max_execution_time }}";
        fastcgi_connect_timeout {{ librenms_nginx_fastcgi_connect_timeout }};
        fastcgi_send_timeout {{ librenms_web_validation_rrd_check_timeout }};
        fastcgi_read_timeout {{ librenms_web_validation_rrd_check_timeout }};
        fastcgi_pass unix:{{ librenms_php_fpm_socket }};
    }

    location ~ [^/]\.php(/|$) {
        fastcgi_pass unix:{{ librenms_php_fpm_socket }};
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_connect_timeout {{ librenms_nginx_fastcgi_connect_timeout }};
        fastcgi_send_timeout {{ librenms_nginx_fastcgi_send_timeout }};
        fastcgi_read_timeout {{ librenms_nginx_fastcgi_read_timeout }};
        include fastcgi.conf;
    }

    location ~ /\. {
        deny all;
    }
}
