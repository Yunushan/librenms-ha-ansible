# Managed by Ansible. Feed remote syslog messages to LibreNMS.

{% if librenms_syslog_listen_udp | bool %}
module(load="imudp")
{% endif %}
{% if librenms_syslog_listen_tcp | bool %}
module(load="imtcp")
{% endif %}
module(load="omprog")

{% if librenms_syslog_suppress_galera_readiness_lifecycle | bool %}
# Socket activation creates a short-lived systemd unit for every readiness
# probe. Keep failures, but discard successful lifecycle chatter before it is
# written locally or forwarded back into LibreNMS.
if (
    $programname == "systemd"
    and $msg contains "librenms-galera-readiness-agent@"
    and (
        $msg contains "Starting "
        or $msg contains "Finished "
        or $msg contains "Deactivated successfully"
    )
) then {
    stop
}

{% endif %}
template(name="librenms" type="list") {
    property(name="{{ librenms_syslog_host_property }}")
    constant(value="||")
    property(name="syslogfacility")
    constant(value="||")
    property(name="syslogpriority")
    constant(value="||")
    property(name="syslogseverity")
    constant(value="||")
    property(name="syslogtag")
    constant(value="||")
    property(name="timegenerated" dateFormat="mysql")
    constant(value="||")
    property(name="msg")
    constant(value="||")
    property(name="programname")
    constant(value="\n")
}

ruleset(name="librenms_remote") {
    action(
        type="omprog"
        binary="{{ librenms_syslog_php_binary }} {{ librenms_install_dir }}/syslog.php"
        template="librenms"
{% if librenms_syslog_action_queue_enabled | bool %}
        queue.type="{{ librenms_syslog_action_queue_type }}"
        queue.filename="{{ librenms_syslog_action_queue_filename }}"
        queue.spoolDirectory="{{ librenms_syslog_action_queue_spool_dir }}"
        queue.size="{{ librenms_syslog_action_queue_size }}"
        queue.maxDiskSpace="{{ librenms_syslog_action_queue_max_disk_space }}"
        queue.saveOnShutdown="{{ librenms_syslog_action_queue_save_on_shutdown | bool | ternary('on', 'off') }}"
        queue.workerThreads="{{ librenms_syslog_action_queue_worker_threads }}"
        action.resumeInterval="{{ librenms_syslog_action_resume_interval }}"
        action.resumeRetryCount="{{ librenms_syslog_action_resume_retry_count }}"
{% endif %}
    )
    stop
}

{% if librenms_syslog_listen_udp | bool %}
input(
    type="imudp"
    port="{{ librenms_syslog_udp_port }}"
    ruleset="librenms_remote"
)
{% endif %}
{% if librenms_syslog_listen_tcp | bool %}
input(
    type="imtcp"
    port="{{ librenms_syslog_tcp_port }}"
    ruleset="librenms_remote"
)
{% endif %}

{% if librenms_syslog_forward_local_logs | bool %}
# Forward this node's local system logs to the LibreNMS syslog receiver.
{{ librenms_syslog_forward_selector }} action(
    type="omfwd"
    target="{{ librenms_syslog_forward_target }}"
    port="{{ librenms_syslog_forward_port }}"
    protocol="{{ librenms_syslog_forward_protocol }}"
)
{% endif %}
