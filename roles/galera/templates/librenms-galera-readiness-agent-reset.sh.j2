#!/usr/bin/env bash
set -u
set -o pipefail

readonly SOCKET_UNIT={{ librenms_galera_readiness_agent_socket_unit | quote }}
readonly SERVICE_UNIT={{ librenms_galera_readiness_agent_service_unit | quote }}
readonly SERVER_PATH={{ librenms_galera_readiness_agent_server_path | quote }}
readonly LEGACY_SERVICE_GLOB={{ (librenms_galera_readiness_agent_legacy_service_unit | regex_replace('@\\.service$', '@*.service')) | quote }}
readonly COMMAND_TIMEOUT={{ librenms_galera_readiness_agent_reset_timeout | int }}
readonly QUIESCE_ATTEMPTS={{ librenms_galera_readiness_agent_reset_attempts | int }}

systemctl_bounded() {
  timeout --kill-after=2s "${COMMAND_TIMEOUT}" systemctl "$@"
}

list_active_workers() {
  # Do not use --all here. Accepted socket workers leave a large inactive
  # unit history, and expanding that history can wedge systemd itself.
  systemctl_bounded list-units \
    --type=service \
    --state=active,activating,deactivating \
    --plain --no-legend --full "${LEGACY_SERVICE_GLOB}" 2>/dev/null \
    | awk '$3 == "active" || $3 == "activating" || $3 == "deactivating" { print $1 }'
}

server_pids() {
  command -v pgrep >/dev/null 2>&1 || return 0
  pgrep -f -- "${SERVER_PATH}" || true
}

signal_server_processes() {
  local signal="$1"
  local pids
  local pid

  pids="$(server_pids)"
  [ -n "${pids}" ] || return 0
  for pid in ${pids}; do
    case "${pid}" in
      ''|*[!0-9]*|1)
        continue
        ;;
    esac
    kill "-${signal}" "${pid}" >/dev/null 2>&1 || true
  done
}

stop_server_processes() {
  local pids

  # The service unit normally owns this process. The explicit PID fallback
  # also removes a server left behind by an interrupted legacy deployment.
  for ((attempt = 1; attempt <= QUIESCE_ATTEMPTS; attempt++)); do
    pids="$(server_pids)"
    [ -n "${pids}" ] || return 0
    signal_server_processes TERM
    sleep 1
  done

  pids="$(server_pids)"
  if [ -n "${pids}" ]; then
    signal_server_processes KILL
    sleep 1
  fi

  [ -z "$(server_pids)" ]
}

reap_workers() {
  local workers="$1"

  [ -n "${workers}" ] || return 0
  # Unit names cannot contain whitespace. Passing the complete discovered set
  # keeps cleanup bounded even when the socket backlog was previously full.
  # shellcheck disable=SC2086
  systemctl_bounded stop --no-block ${workers} >/dev/null 2>&1 || true
  # shellcheck disable=SC2086
  systemctl_bounded kill --kill-who=all --signal=TERM ${workers} >/dev/null 2>&1 || true
  # A legacy accepted worker can remain in deactivating state while its
  # socket is already closed. Do not leave it behind to accumulate in PID 1.
  # shellcheck disable=SC2086
  systemctl_bounded kill --kill-who=all --signal=KILL ${workers} >/dev/null 2>&1 || true
  # shellcheck disable=SC2086
  systemctl_bounded reset-failed ${workers} >/dev/null 2>&1 || true
}

stop_socket() {
  local socket_state
  local socket_rc

  # Do not wait for systemd to synchronously drain a busy socket unit. Queue
  # the stop, then verify that the listener really left the active states.
  systemctl_bounded stop --no-block "${SOCKET_UNIT}" >/dev/null 2>&1 || true

  for ((attempt = 1; attempt <= QUIESCE_ATTEMPTS; attempt++)); do
    socket_state="$(systemctl_bounded is-active "${SOCKET_UNIT}" 2>/dev/null)"
    socket_rc=$?
    if [ "${socket_rc}" -eq 124 ]; then
      sleep 1
      continue
    fi
    case "${socket_state}" in
      inactive|failed|unknown)
        return 0
        ;;
    esac
    sleep 1
  done

  printf 'could not stop readiness socket unit: %s (state=%s)\n' \
    "${SOCKET_UNIT}" "${socket_state:-unknown}" >&2
  return 1
}

stop_persistent_service() {
  local service_state
  local service_rc

  systemctl_bounded stop --no-block "${SERVICE_UNIT}" >/dev/null 2>&1 || true
  for ((attempt = 1; attempt <= QUIESCE_ATTEMPTS; attempt++)); do
    service_state="$(systemctl_bounded is-active "${SERVICE_UNIT}" 2>/dev/null)"
    service_rc=$?
    if [ "${service_rc}" -eq 124 ]; then
      sleep 1
      continue
    fi
    case "${service_state}" in
      inactive|failed|unknown)
        systemctl_bounded reset-failed "${SERVICE_UNIT}" >/dev/null 2>&1 || true
        return 0
        ;;
    esac
    sleep 1
  done

  systemctl_bounded kill --kill-who=all --signal=TERM "${SERVICE_UNIT}" >/dev/null 2>&1 || true
  for ((attempt = 1; attempt <= QUIESCE_ATTEMPTS; attempt++)); do
    service_state="$(systemctl_bounded is-active "${SERVICE_UNIT}" 2>/dev/null)"
    service_rc=$?
    if [ "${service_rc}" -eq 124 ]; then
      sleep 1
      continue
    fi
    case "${service_state}" in
      inactive|failed|unknown)
        systemctl_bounded reset-failed "${SERVICE_UNIT}" >/dev/null 2>&1 || true
        return 0
        ;;
    esac
    sleep 1
  done

  systemctl_bounded kill --kill-who=all --signal=KILL "${SERVICE_UNIT}" >/dev/null 2>&1 || true
  for ((attempt = 1; attempt <= QUIESCE_ATTEMPTS; attempt++)); do
    service_state="$(systemctl_bounded is-active "${SERVICE_UNIT}" 2>/dev/null)"
    service_rc=$?
    if [ "${service_rc}" -eq 124 ]; then
      sleep 1
      continue
    fi
    case "${service_state}" in
      inactive|failed|unknown)
        systemctl_bounded reset-failed "${SERVICE_UNIT}" >/dev/null 2>&1 || true
        return 0
        ;;
    esac
    sleep 1
  done

  printf 'could not stop readiness service unit: %s (state=%s)\n' \
    "${SERVICE_UNIT}" "${service_state:-unknown}" >&2
  return 1
}

# Close the listener first so no new accepted workers appear while stale
# connection units are being reaped.
if ! stop_socket; then
  exit 1
fi
if ! stop_persistent_service; then
  exit 1
fi
if ! stop_server_processes; then
  printf 'readiness server process did not stop: %s\n' "${SERVER_PATH}" >&2
  exit 1
fi

workers="$(list_active_workers)"
if [ "$?" -eq 124 ]; then
  printf 'systemd did not respond while listing readiness workers\n' >&2
  exit 1
fi
reap_workers "${workers}"

for ((attempt = 1; attempt <= QUIESCE_ATTEMPTS; attempt++)); do
  remaining="$(list_active_workers)"
  if [ "$?" -eq 124 ]; then
    printf 'systemd did not respond while checking readiness workers\n' >&2
    exit 1
  fi
  if [ -z "${remaining}" ]; then
    exit 0
  fi

  reap_workers "${remaining}"
  sleep 1
done

remaining="$(list_active_workers)"
printf 'readiness agent workers did not stop: %s\n' "${remaining//$'\n'/ }" >&2
exit 1
