[Unit]
Description=LibreNMS Galera readiness agent connection

[Service]
Type=oneshot
# Accepted socket workers otherwise remain in systemd's inactive unit cache;
# collect each completed probe so frequent HAProxy checks cannot exhaust PID 1.
CollectMode=inactive-or-failed
# A stalled database query or systemd socket worker must not consume the
# socket backlog indefinitely during a PID 1 or database outage.
TimeoutStartSec={{ librenms_galera_readiness_agent_service_timeout }}
TimeoutStopSec={{ librenms_galera_readiness_agent_service_timeout }}
KillMode=control-group
ExecStart={{ librenms_galera_readiness_agent_path }}
StandardInput=socket
StandardOutput=socket
StandardError=journal
