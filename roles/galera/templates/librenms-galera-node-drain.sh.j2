#!/usr/bin/env bash
set -euo pipefail

ENABLED={{ (librenms_galera_web_drain_enabled | bool) | ternary('1', '0') }}
LOCAL_WEB_MEMBER={{ (inventory_hostname in (librenms_active_web_nodes | default([]))) | ternary('1', '0') }}
WEB_DRAIN_PATH={{ librenms_galera_web_drain_path | quote }}
WEB_DRAIN_COMPAT_PATH={{ librenms_galera_web_drain_compat_path | quote }}
BACKEND_DRAIN_PATH={{ librenms_galera_backend_drain_path | quote }}
STATE_PATH={{ librenms_galera_web_drain_state_path | quote }}
COMPAT_OWNERSHIP_PATH="${STATE_PATH}.compat-owned"
LOCK_PATH={{ librenms_galera_web_drain_lock_path | quote }}
LOCK_TIMEOUT={{ librenms_galera_web_drain_lock_timeout | int }}
DRAIN_DELAY={{ librenms_galera_web_drain_delay | int }}
UNIT_STOP_TIMEOUT={{ librenms_galera_web_drain_unit_stop_timeout | int }}
UNIT_KILL_GRACE={{ librenms_galera_web_drain_unit_kill_grace | int }}
SYSTEMCTL_TIMEOUT={{ librenms_galera_web_drain_systemctl_timeout | int }}
SYSTEMD_RECOVERY_TIMEOUT={{ librenms_galera_web_drain_systemd_recovery_timeout | int }}
SYSTEMD_RECOVERY_POLL_DELAY={{ librenms_galera_web_drain_systemd_recovery_poll_delay | int }}
BACKEND_DRAIN_TIMEOUT={{ librenms_galera_backend_drain_timeout | int }}
BACKEND_DRAIN_POLL_DELAY={{ librenms_galera_backend_drain_poll_delay | int }}
BACKEND_DRAIN_MAX_CLIENT_CONNECTIONS={{ librenms_galera_backend_drain_max_client_connections | int }}
BACKEND_FORCE_DISCONNECT_CLIENTS={{ (librenms_galera_backend_force_disconnect_clients | bool) | ternary('1', '0') }}
BACKEND_FORCE_DISCONNECT_TIMEOUT={{ librenms_galera_backend_force_disconnect_timeout | int }}
BACKEND_REJOIN_DELAY={{ librenms_galera_backend_rejoin_delay | int }}
QUERY_TIMEOUT={{ librenms_galera_readiness_agent_query_timeout | int }}
MARIADB_SERVICE={{ librenms_mariadb_service_name | quote }}
MARIADB_SOCKET={{ librenms_mariadb_socket | quote }}
HAPROXY_HEALTH_USER={{ librenms_haproxy_db_health_user | quote }}
PHP_FPM_SERVICE={{ librenms_php_fpm_service_effective | default(librenms_php_fpm_service_name | default('')) | quote }}
DAILY_TIMER_UNIT=librenms-daily.timer
DAILY_SERVICE_UNIT=librenms-daily.service
QUIESCE_UNITS=(
{% for unit in librenms_galera_web_drain_quiesce_units %}
  {{ unit | quote }}
{% endfor %}
)
CONFLICTING_UNITS=(
{% for unit in librenms_galera_web_drain_conflicting_units %}
  {{ unit | quote }}
{% endfor %}
)

log() {
  logger -t librenms-galera-node-drain -- "$*" 2>/dev/null || true
  printf '%s\n' "$*" >&2
}

systemctl_bounded() {
  timeout "${SYSTEMCTL_TIMEOUT}" systemctl "$@"
}

systemd_manager_ready() {
  systemctl_bounded show --property=Version --value >/dev/null 2>&1
}

wait_for_systemd_manager() {
  local context="${1:-continuing Galera maintenance}"
  local deadline
  local waiting=0

  deadline=$((SECONDS + SYSTEMD_RECOVERY_TIMEOUT))
  while ! systemd_manager_ready; do
    if [ "${waiting}" -eq 0 ]; then
      log "systemd manager is not responding while ${context}; waiting up to ${SYSTEMD_RECOVERY_TIMEOUT}s"
      waiting=1
    fi
    if [ "${SECONDS}" -ge "${deadline}" ]; then
      log "systemd manager did not recover while ${context}"
      return 1
    fi
    sleep "${SYSTEMD_RECOVERY_POLL_DELAY}"
  done

  if [ "${waiting}" -eq 1 ]; then
    log "systemd manager recovered; ${context}"
  fi
}

unit_active_state() {
  local state
  local unit="$1"

  state=$(systemctl_bounded show --property=ActiveState --value "${unit}" 2>/dev/null || true)
  case "${state}" in
    active|reloading|inactive|failed|activating|deactivating|maintenance|refreshing)
      printf '%s\n' "${state}"
      ;;
    *)
      printf '%s\n' 'unknown'
      return 1
      ;;
  esac
}

queue_unit_action() {
  local action="$1"
  local unit="$2"

  if ! wait_for_systemd_manager "preparing to ${action} ${unit}"; then
    return 1
  fi
  if systemctl_bounded "${action}" --no-block "${unit}" >/dev/null 2>&1; then
    return 0
  fi

  log "systemd did not accept ${action} for ${unit}; waiting for manager recovery before one retry"
  if ! wait_for_systemd_manager "retrying ${action} for ${unit}"; then
    return 1
  fi
  if ! systemctl_bounded "${action}" --no-block "${unit}" >/dev/null 2>&1; then
    log "systemd did not accept ${action} for ${unit} after recovery"
    return 1
  fi
}

managed_here() {
  [ "${ENABLED}" = '1' ]
}

assert_no_conflicting_units() {
  local state
  local unit

  wait_for_systemd_manager 'checking conflicting maintenance units'
  for unit in "${CONFLICTING_UNITS[@]}"; do
    state=$(unit_active_state "${unit}" || true)
    case "${state}" in
      inactive|failed)
        ;;
      *)
        log "refusing Galera drain while conflicting unit ${unit} is ${state}"
        return 1
        ;;
    esac
  done
}

assert_unit_inactive() {
  local state
  local unit="$1"

  wait_for_systemd_manager "checking ${unit}"
  state=$(unit_active_state "${unit}" || true)
  case "${state}" in
    inactive|failed)
      ;;
    *)
      log "refusing Galera drain while conflicting unit ${unit} is ${state}"
      return 1
      ;;
  esac
}

activate_web_drain_markers() {
  [ "${LOCAL_WEB_MEMBER}" = '1' ] || return 0

  touch "${WEB_DRAIN_PATH}"
  if [ -n "${WEB_DRAIN_COMPAT_PATH}" ] \
      && [ "${WEB_DRAIN_COMPAT_PATH}" != "${WEB_DRAIN_PATH}" ] \
      && [ ! -e "${WEB_DRAIN_COMPAT_PATH}" ]; then
    touch "${WEB_DRAIN_COMPAT_PATH}"
    touch "${COMPAT_OWNERSHIP_PATH}"
  fi
}

clear_web_drain_markers() {
  [ "${LOCAL_WEB_MEMBER}" = '1' ] || return 0

  rm -f "${WEB_DRAIN_PATH}"
  if [ -e "${COMPAT_OWNERSHIP_PATH}" ]; then
    rm -f "${WEB_DRAIN_COMPAT_PATH}" "${COMPAT_OWNERSHIP_PATH}"
  fi
}

galera_ready() {
  local status

  status=$(timeout "${QUERY_TIMEOUT}" \
    mysql --protocol=socket --socket="${MARIADB_SOCKET}" -Nse \
    "SHOW GLOBAL STATUS WHERE Variable_name IN ('wsrep_cluster_status','wsrep_ready','wsrep_local_state_comment');" \
    2>/dev/null || true)

  printf '%s\n' "${status}" | grep -Eq 'wsrep_cluster_status[[:space:]]+Primary' \
    && printf '%s\n' "${status}" | grep -Eq 'wsrep_ready[[:space:]]+ON' \
    && printf '%s\n' "${status}" | grep -Eq 'wsrep_local_state_comment[[:space:]]+Synced'
}

active_php_fpm_services() {
  local state
  local unit

  if [ -n "${PHP_FPM_SERVICE}" ]; then
    state=$(unit_active_state "${PHP_FPM_SERVICE}" || true)
    if [ "${state}" = 'active' ]; then
      printf '%s\n' "${PHP_FPM_SERVICE}"
    fi
  fi

  while IFS= read -r unit; do
    [ -n "${unit}" ] || continue
    state=$(unit_active_state "${unit}" || true)
    if [ "${state}" = 'active' ]; then
      printf '%s\n' "${unit}"
    fi
  done < <(
    systemctl_bounded list-unit-files --type=service --no-legend \
      'php*-fpm.service' 'php-fpm.service' 2>/dev/null \
      | awk '{print $1}' \
      | sort -u
  )
}

record_active_units() {
  local state
  local temporary_state
  local unit

  wait_for_systemd_manager 'recording active LibreNMS units before drain'
  temporary_state="${STATE_PATH}.tmp.$$"
  umask 077
  : > "${temporary_state}"

  if [ "${LOCAL_WEB_MEMBER}" = '1' ]; then
    for unit in "${DAILY_TIMER_UNIT}" "${QUIESCE_UNITS[@]}"; do
      state=$(unit_active_state "${unit}" || true)
      case "${state}" in
        active|reloading|activating)
          if ! grep -Fqx -- "${unit}" "${temporary_state}"; then
            printf '%s\n' "${unit}" >> "${temporary_state}"
          fi
          ;;
        unknown)
          rm -f "${temporary_state}"
          log "could not confirm ${unit} state before Galera drain"
          return 1
          ;;
      esac
    done
  fi

  mv -f "${temporary_state}" "${STATE_PATH}"
}

recorded_unit() {
  local unit="$1"

  [ -r "${STATE_PATH}" ] && grep -Fqx -- "${unit}" "${STATE_PATH}"
}

wait_for_unit_to_stop() {
  local unit="$1"
  local wait_seconds="$2"
  local deadline
  local manager_recovered=0
  local state

  deadline=$((SECONDS + wait_seconds))
  while true; do
    state=$(unit_active_state "${unit}" || true)
    case "${state}" in
      inactive|failed)
        return 0
        ;;
      unknown)
        if [ "${manager_recovered}" -eq 1 ] \
            || ! wait_for_systemd_manager "checking whether ${unit} stopped"; then
          return 1
        fi
        manager_recovered=1
        if ! queue_unit_action stop "${unit}"; then
          return 1
        fi
        deadline=$((SECONDS + wait_seconds))
        continue
        ;;
    esac

    if [ "${SECONDS}" -ge "${deadline}" ]; then
      return 1
    fi
    sleep 1
  done
}

stop_unit_bounded() {
  local unit="$1"
  local state

  if ! queue_unit_action stop "${unit}"; then
    return 1
  fi
  if wait_for_unit_to_stop "${unit}" "${UNIT_STOP_TIMEOUT}"; then
    return 0
  fi

  state=$(unit_active_state "${unit}" || true)
  if [ "${state}" = 'unknown' ]; then
    log "failed to stop ${unit} because systemd could not confirm its state"
    return 1
  fi
  case "${unit}" in
    *.service)
      ;;
    *)
      log "${unit} remained ${state} after ${UNIT_STOP_TIMEOUT}s; refusing cgroup signals for non-service unit"
      return 1
      ;;
  esac

  log "${unit} remained ${state} after ${UNIT_STOP_TIMEOUT}s; sending SIGTERM to its service cgroup"
  systemctl_bounded kill --kill-whom=all --signal=TERM "${unit}" 2>/dev/null || true
  if wait_for_unit_to_stop "${unit}" "${UNIT_KILL_GRACE}"; then
    return 0
  fi

  log "${unit} did not stop after SIGTERM; sending SIGKILL to its service cgroup"
  systemctl_bounded kill --kill-whom=all --signal=KILL "${unit}" 2>/dev/null || true
  queue_unit_action stop "${unit}" || true
  if wait_for_unit_to_stop "${unit}" "${UNIT_KILL_GRACE}"; then
    return 0
  fi

  state=$(unit_active_state "${unit}" || true)
  log "failed to stop ${unit}; final ActiveState=${state}"
  return 1
}

stop_recorded_unit() {
  local unit="$1"

  if recorded_unit "${unit}"; then
    stop_unit_bounded "${unit}"
  fi
}

start_recorded_unit() {
  local unit="$1"

  if recorded_unit "${unit}"; then
    queue_unit_action start "${unit}"
  fi
}

quiesce_daily_timer() {
  [ "${LOCAL_WEB_MEMBER}" = '1' ] || return 0

  stop_recorded_unit "${DAILY_TIMER_UNIT}"
  assert_unit_inactive "${DAILY_SERVICE_UNIT}"
}

stop_recorded_units() {
  local unit

  [ -r "${STATE_PATH}" ] || return 0
  while IFS= read -r unit; do
    [ -n "${unit}" ] || continue
    if ! stop_unit_bounded "${unit}"; then
      return 1
    fi
  done < "${STATE_PATH}"
}

start_recorded_units() {
  local failed=0
  local unit

  [ -r "${STATE_PATH}" ] || return 0
  if ! wait_for_systemd_manager 'restoring recorded LibreNMS units'; then
    return 1
  fi
  while IFS= read -r unit; do
    [ -n "${unit}" ] || continue
    if ! queue_unit_action start "${unit}"; then
      failed=1
      if ! systemd_manager_ready; then
        break
      fi
    fi
  done < "${STATE_PATH}"

  if [ "${failed}" -ne 0 ]; then
    log 'one or more recorded LibreNMS units could not be restored'
    return 1
  fi
}

active_client_connections() {
  local count

  count=$(timeout "${QUERY_TIMEOUT}" \
    mysql --protocol=socket --socket="${MARIADB_SOCKET}" -Nse \
    "SELECT COUNT(*)
       FROM information_schema.PROCESSLIST
      WHERE ID <> CONNECTION_ID()
        AND COALESCE(USER, '') NOT IN (
          '', 'unauthenticated user', 'system user', 'event_scheduler',
          '${HAPROXY_HEALTH_USER}'
        );" \
    2>/dev/null || true)

  if [[ "${count}" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "${count}"
    return 0
  fi

  return 1
}

force_disconnect_client_connections() {
  local client_count
  local kill_statements

  kill_statements=$(timeout "${QUERY_TIMEOUT}" \
    mysql --protocol=socket --socket="${MARIADB_SOCKET}" -Nse \
    "SELECT CONCAT('KILL CONNECTION ', ID, ';')
       FROM information_schema.PROCESSLIST
      WHERE ID <> CONNECTION_ID()
        AND COALESCE(USER, '') NOT IN (
          '', 'unauthenticated user', 'system user', 'event_scheduler',
          '${HAPROXY_HEALTH_USER}'
        );" \
    2>/dev/null || true)

  client_count=$(printf '%s\n' "${kill_statements}" \
    | grep -Ec '^KILL CONNECTION [0-9]+;$' || true)
  if [ "${client_count}" -eq 0 ]; then
    return 0
  fi

  log "graceful database drain expired; disconnecting ${client_count} lingering client(s)"
  printf '%s\n' "${kill_statements}" \
    | timeout "${QUERY_TIMEOUT}" \
      mysql --force --protocol=socket --socket="${MARIADB_SOCKET}" \
        >/dev/null 2>&1 || true
}

wait_for_forced_client_disconnects() {
  local connections
  local deadline
  local state

  deadline=$((SECONDS + BACKEND_FORCE_DISCONNECT_TIMEOUT))
  while true; do
    state=$(unit_active_state "${MARIADB_SERVICE}" || true)
    case "${state}" in
      inactive|failed)
        return 0
        ;;
      unknown)
        if ! wait_for_systemd_manager 'checking MariaDB after forced client disconnect'; then
          return 1
        fi
        continue
        ;;
    esac

    connections=$(active_client_connections || true)
    if [[ "${connections}" =~ ^[0-9]+$ ]] \
        && [ "${connections}" -le "${BACKEND_DRAIN_MAX_CLIENT_CONNECTIONS}" ]; then
      log "lingering database clients disconnected (${connections} active)"
      return 0
    fi

    if [ "${SECONDS}" -ge "${deadline}" ]; then
      log "database clients remained after forced disconnect (${connections:-unknown} active)"
      return 1
    fi

    sleep "${BACKEND_DRAIN_POLL_DELAY}"
  done
}

wait_for_client_connections_to_drain() {
  local connections
  local deadline
  local state

  deadline=$((SECONDS + BACKEND_DRAIN_TIMEOUT))
  while true; do
    state=$(unit_active_state "${MARIADB_SERVICE}" || true)
    case "${state}" in
      inactive|failed)
        log 'MariaDB is already stopped; no client sessions remain'
        return 0
        ;;
      unknown)
        if ! wait_for_systemd_manager 'checking MariaDB client drain'; then
          return 1
        fi
        continue
        ;;
    esac

    connections=$(active_client_connections || true)
    if [[ "${connections}" =~ ^[0-9]+$ ]] \
        && [ "${connections}" -le "${BACKEND_DRAIN_MAX_CLIENT_CONNECTIONS}" ]; then
      log "database clients drained (${connections} active)"
      return 0
    fi

    if [ "${SECONDS}" -ge "${deadline}" ]; then
      log "database drain timed out after ${BACKEND_DRAIN_TIMEOUT}s (${connections:-unknown} active clients)"
      return 1
    fi

    sleep "${BACKEND_DRAIN_POLL_DELAY}"
  done
}

rollback_drain() {
  if ! galera_ready; then
    log 'leaving traffic drained because local Galera is not Primary/ready/Synced'
    return 0
  fi

  if ! start_recorded_units; then
    log 'leaving traffic drained because recorded LibreNMS units could not be restored'
    return 1
  fi
  if ! wait_for_systemd_manager 'confirming rollback restoration before reopening traffic'; then
    log 'leaving traffic drained because systemd restoration could not be confirmed'
    return 1
  fi
  rm -f "${BACKEND_DRAIN_PATH}"
  sleep "${BACKEND_REJOIN_DELAY}"
  clear_web_drain_markers
  rm -f "${STATE_PATH}"
  log 'cancelled Galera maintenance and restored traffic without restarting MariaDB'
}

enter_drain() {
  local already_entered=0
  local state_created=0

  if ! managed_here; then
    printf '%s\n' 'not-managed'
    return 0
  fi

  if [ -e "${BACKEND_DRAIN_PATH}" ]; then
    already_entered=1
  fi

  assert_no_conflicting_units
  if [ "${LOCAL_WEB_MEMBER}" = '1' ]; then
    assert_unit_inactive "${DAILY_SERVICE_UNIT}"
  fi

  if [ ! -r "${STATE_PATH}" ]; then
    record_active_units
    state_created=1
  fi

  if ! quiesce_daily_timer; then
    if [ "${state_created}" -eq 1 ]; then
      start_recorded_unit "${DAILY_TIMER_UNIT}"
      rm -f "${STATE_PATH}"
    fi
    return 1
  fi

  touch "${BACKEND_DRAIN_PATH}"
  activate_web_drain_markers

  if [ "${already_entered}" -eq 0 ]; then
    log "entered Galera backend drain; waiting ${DRAIN_DELAY}s for HAProxy"
    sleep "${DRAIN_DELAY}"
  fi

  if ! stop_recorded_units; then
    log 'failed to quiesce a recorded unit; rolling back Galera drain'
    rollback_drain
    return 1
  fi
  if ! wait_for_client_connections_to_drain; then
    if [ "${BACKEND_FORCE_DISCONNECT_CLIENTS}" != '1' ] \
        || ! force_disconnect_client_connections \
        || ! wait_for_forced_client_disconnects; then
      rollback_drain
      return 1
    fi
  fi

  if [ "${already_entered}" -eq 1 ]; then
    printf '%s\n' 'already-entered'
  else
    printf '%s\n' 'entered'
  fi
}

exit_drain() {
  local php_service

  if ! managed_here; then
    printf '%s\n' 'not-managed'
    return 0
  fi

  if [ ! -e "${BACKEND_DRAIN_PATH}" ] \
      && [ ! -e "${WEB_DRAIN_PATH}" ] \
      && [ ! -e "${STATE_PATH}" ]; then
    printf '%s\n' 'not-entered'
    return 0
  fi

  if ! galera_ready; then
    log 'refusing to leave drain while local Galera is not Primary/ready/Synced'
    return 1
  fi

  wait_for_systemd_manager 'restoring LibreNMS units after Galera maintenance'
  if [ "${LOCAL_WEB_MEMBER}" = '1' ]; then
    while IFS= read -r php_service; do
      [ -n "${php_service}" ] || continue
      if ! systemctl_bounded try-reload-or-restart --no-block "${php_service}"; then
        log "failed to queue PHP-FPM refresh for ${php_service}; leaving traffic drained"
        return 1
      fi
    done < <(active_php_fpm_services | sort -u)
  fi

  if ! start_recorded_units; then
    log 'recorded LibreNMS units were not restored; leaving traffic drained'
    return 1
  fi
  if ! wait_for_systemd_manager 'confirming restored units before reopening traffic'; then
    log 'systemd restoration could not be confirmed; leaving traffic drained'
    return 1
  fi
  rm -f "${BACKEND_DRAIN_PATH}"
  sleep "${BACKEND_REJOIN_DELAY}"
  clear_web_drain_markers
  rm -f "${STATE_PATH}"
  log 'left Galera drain after readiness and HAProxy rejoin verification'
  printf '%s\n' 'exited'
}

mkdir -p \
  "$(dirname "${LOCK_PATH}")" \
  "$(dirname "${WEB_DRAIN_PATH}")" \
  "$(dirname "${WEB_DRAIN_COMPAT_PATH}")" \
  "$(dirname "${BACKEND_DRAIN_PATH}")" \
  "$(dirname "${STATE_PATH}")"
exec 9>"${LOCK_PATH}"
if ! flock -w "${LOCK_TIMEOUT}" 9; then
  log "could not acquire drain lock within ${LOCK_TIMEOUT}s"
  exit 1
fi

case "${1:-status}" in
  enter)
    enter_drain
    ;;
  exit)
    exit_drain
    ;;
  status)
    if [ -e "${BACKEND_DRAIN_PATH}" ] || [ -e "${WEB_DRAIN_PATH}" ]; then
      printf '%s\n' 'entered'
    else
      printf '%s\n' 'not-entered'
    fi
    ;;
  *)
    printf 'Usage: %s {enter|exit|status}\n' "$0" >&2
    exit 2
    ;;
esac
