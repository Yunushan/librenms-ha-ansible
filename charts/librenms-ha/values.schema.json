{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "timezone": {"type": "string", "minLength": 1},
    "image": {
      "type": "object",
      "required": ["repository", "requireDigest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
        "requireDigest": {"type": "boolean"},
        "pullSecrets": {"type": "array", "items": {"type": "object"}}
      }
    },
    "production": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}}
    },
    "web": {"$ref": "#/definitions/workload"},
    "dispatcher": {"$ref": "#/definitions/workload"},
    "database": {
      "type": "object",
      "properties": {
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "name": {"type": "string", "minLength": 1},
        "user": {"type": "string", "minLength": 1},
        "timeout": {"type": "integer", "minimum": 1}
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "sentinel": {"type": "string"},
        "sentinelService": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "database": {"type": "integer", "minimum": 0},
        "cacheDatabase": {"type": "integer", "minimum": 0}
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "databasePasswordKey": {"type": "string", "minLength": 1},
        "redisPasswordKey": {"type": "string", "minLength": 1}
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessModes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "size": {"type": "string", "minLength": 1},
        "mountPath": {"type": "string", "minLength": 1}
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object"},
        "hosts": {"type": "array", "items": {"$ref": "#/definitions/ingressHost"}},
        "tls": {"type": "array", "items": {"$ref": "#/definitions/tlsEntry"}}
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "tls": {
          "type": "object",
          "properties": {
            "termination": {"type": "string", "enum": ["edge", "reencrypt", "passthrough"]}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "ingress": {"type": "array", "items": {"$ref": "#/definitions/networkRule"}},
        "egress": {"type": "array", "items": {"$ref": "#/definitions/networkRule"}}
      }
    },
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "affinity": {"type": "object"},
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": {"type": "boolean"},
        "seccompProfile": {
          "type": "object",
          "properties": {"type": {"type": "string", "enum": ["RuntimeDefault", "Localhost", "Unconfined"]}}
        }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": {"type": "boolean"},
        "capabilities": {
          "type": "object",
          "properties": {"drop": {"type": "array", "items": {"type": "string"}}}
        }
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "health": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "initialDelaySeconds": {"type": "integer", "minimum": 0},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      }
    }
  },
  "definitions": {
    "workload": {
      "type": "object",
      "properties": {
        "replicas": {"type": "integer", "minimum": 0},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "service": {
          "type": "object",
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "resources": {"$ref": "#/definitions/resources"},
        "topologySpreadConstraints": {"type": "array", "items": {"$ref": "#/definitions/topologyConstraint"}}
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "limits": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "topologyConstraint": {
      "type": "object",
      "properties": {
        "maxSkew": {"type": "integer", "minimum": 1},
        "topologyKey": {"type": "string", "minLength": 1},
        "whenUnsatisfiable": {"type": "string", "enum": ["DoNotSchedule", "ScheduleAnyway"]}
      }
    },
    "ingressHost": {
      "type": "object",
      "properties": {
        "host": {"type": "string"},
        "paths": {"type": "array", "items": {"$ref": "#/definitions/ingressPath"}}
      }
    },
    "ingressPath": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "pathType": {"type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"]}
      }
    },
    "tlsEntry": {
      "type": "object",
      "properties": {
        "secretName": {"type": "string"},
        "hosts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "networkRule": {
      "type": "object",
      "properties": {
        "from": {"type": "array", "items": {"$ref": "#/definitions/networkPeer"}},
        "to": {"type": "array", "items": {"$ref": "#/definitions/networkPeer"}},
        "ports": {"type": "array", "items": {"$ref": "#/definitions/networkPort"}}
      }
    },
    "networkPeer": {
      "type": "object",
      "properties": {
        "namespaceSelector": {"type": "object"},
        "podSelector": {"type": "object"},
        "ipBlock": {"type": "object"}
      }
    },
    "networkPort": {
      "type": "object",
      "properties": {
        "protocol": {"type": "string", "enum": ["TCP", "UDP", "SCTP"]},
        "port": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 65535},
            {"type": "string", "minLength": 1}
          ]
        }
      }
    }
  }
}
